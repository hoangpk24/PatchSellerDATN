@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>@Constant.PageTitleAdmin.Replace(" -", "")</PageTitle>

<PageNotSupport />

@if(_isLoading)
{
    <LoadingGlobal />
} else 
{
    <CascadingValue Value="_mine" Name="@Constant.CascadingNameParams.Mine">
        <CascadingValue Value="_token" Name="@Constant.CascadingNameParams.Token">
                <main class="hidden h-screen w-screen overflow-hidden lg:flex">
                    <Nav OnLoggedOut="HandleLogout" OnChangePassword="HandleChangePassword" />

                    <section class="max-w-[calc(100lvw-18.75rem)] h-screen w-full overflow-auto bg-slate-50">
                        <div class="border-b border-solid border-slate-200 bg-white px-6 py-4">
                            <MudBreadcrumbs Class="!p-0 !text-sm" Items="_itemBreadcrumbs" Separator="/"></MudBreadcrumbs>
                        </div>

                        <PermissionGuard Mine="@_mine">
                            @Body
                        </PermissionGuard>
                    </section>
                </main>
        </CascadingValue>
    </CascadingValue>
}

