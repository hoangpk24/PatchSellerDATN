    protected override void OnInitialized()
    {
        navigation.LocationChanged += HandleLocationChanged;
        UpdateBreadcrumbs(navigation.Uri);
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeAuth();
        }
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateBreadcrumbs(e.Location);

        if (_mine == null && !_isLoading)
        {
            await InitializeAuth();
        }

        StateHasChanged();
    }

    private async Task InitializeAuth()
    {
        _isLoading = true;
        try
        {
            await PerformAuthCheck();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task PerformAuthCheck()
    {
        try
        {
            _token = await _localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
            var expired = await _localStorage.GetItemAsStringAsync(Constant.TokenExpiredLocalStorage);

            if (string.IsNullOrEmpty(_token))
            {
                await ClearLocalStorageAndNavigate(RouterConfig.Admin.Login);
                return;
            }

            if (!string.IsNullOrEmpty(expired))
            {
                if (DateTime.TryParse(expired.Trim('"'), out DateTime expirationTime))
                {
                    if (expirationTime <= DateTime.Now)
                    {
                        await ClearLocalStorageAndNavigate(RouterConfig.Admin.Login);
                        return;
                    }
                }
            }

            try
            {
                _mine = await _adminStaffService.GetMe(_token.Trim('"'));

                if (_mine == null || !_mine.IsStaff || _mine.Role == Constant.Role.Customer)
                {
                    navigation.NavigateTo(RouterConfig.AccessDenied);
                    _isLoading = false;
                    return;
                }

                var userInfoJson = JsonSerializer.Serialize(_mine);
                await _localStorage.SetItemAsStringAsync(Constant.UserInfoLocalStorage, userInfoJson);
            }
            catch (Exception)
            {
                await ClearLocalStorageAndNavigate(RouterConfig.Admin.Login);
                return;
            }

            // if (_mine != null && _mine.IsExpired)
            // {
            //     await ClearLocalStorageAndNavigate(RouterConfig.Admin.Login);
            //     return;
            // }

            // if (_mine != null && _mine.Role == Constant.Role.Customer)
            // {
            //     navigation.NavigateTo(RouterConfig.AccessDenied, true);
            //     _isLoading = false;
            //     return;
            // }

            // if (_mine != null)
            // {
            //     var userInfoJson = JsonSerializer.Serialize(_mine);
            //     await _localStorage.SetItemAsStringAsync(Constant.UserInfoLocalStorage, userInfoJson);
            // }
        }
        catch (Exception e) {}
    }

    private async Task HandleChangePassword()
    {
        var paraeters = new DialogParameters<Components.Common.Admin.ChangePasswordDialog>
        {
            {x => x._token, _token}
        };

        var dialog = await _dialogService.ShowAsync<Components.Common.Admin.ChangePasswordDialog>("Options Dialog", paraeters, _dialogOptions);
    }

    private async Task HandleLogout()
    {
        await ClearLocalStorageAndNavigate(RouterConfig.Admin.Login);
    }

    public async Task ClearLocalStorageAndNavigate(string route)
    {
        await _localStorage.RemoveItemAsync(Constant.TokenNameLocalStorage);
        await _localStorage.RemoveItemAsync(Constant.TokenExpiredLocalStorage);
        await _localStorage.RemoveItemAsync(Constant.UserInfoLocalStorage);
        await _localStorage.RemoveItemAsync(Constant.UserFirstLoginLocalStorage);

        _isLoading = false;
        _mine = null;
        _token = string.Empty;
        navigation.NavigateTo(route, true);
    }

    public void Dispose()
    {
        navigation.LocationChanged -= HandleLocationChanged;
    }

    private void UpdateBreadcrumbs(string url)
    {
        var uri = new Uri(url);
        var currentPath = uri.AbsolutePath.ToLower().TrimEnd('/');

        var match = _breadcrumbConfig.FirstOrDefault(x =>
        {
            var configPath = x.Key.ToLower().TrimEnd('/');

            var currentSegments = currentPath.Split('/');
            var configSegments = configPath.Split('/');

            if (currentSegments.Length != configSegments.Length) return false;

            for (int i = 0; i < configSegments.Length; i++)
            {
                if (configSegments[i] == ":id") continue;

                if (configSegments[i] != currentSegments[i]) return false;
            }
            return true;
        });

        if (match.Value != null)
        {
            _itemBreadcrumbs = match.Value;
        }
        else
        {
            _itemBreadcrumbs = new List<BreadcrumbItem>
        {
            new("Trang Chủ", href: RouterConfig.Admin.Home)
        };
        }
    }

