@inherits LayoutComponentBase

@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<PageTitle>@Constant.PageTitleUser.Replace("-", "")</PageTitle>

<MudLayout Class="bg-black-layout pt-20">
    <Header />

    <main class="lg:min-h-[calc(100lvh-621px)]">
        @Body
    </main>

    <Footer />
</MudLayout>

<MudScrollToTop Class="group !bottom-10 !right-10 !border-2 !border-solid !border-white !bg-transparent !shadow-none hover:!bg-black-default">
    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Large" Class="!text-white" />
</MudScrollToTop>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<style>
    .mud-breadcrumb-item a {
        color: white !important;
    }

    .mud-breadcrumb-separator span {
        color: white !important;
    }
</style>
