<div class="hide-scrollbar flex gap-4 overflow-x-auto pb-4 lg:grid lg:grid-cols-4 lg:overflow-visible">
    @for (int i = 0; i < 8; i++)
    {
        <div class="w-[327px] flex-shrink-0 lg:w-full">
            <div class="flex flex-col gap-4">
                <div class="w-full rounded-lg !bg-white/5" style="aspect-ratio: 1/1.5;">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" Width="100%" Animation="Animation.Wave" />
                </div>
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="90%" Height="24px" Class="!bg-white/5" />
                    
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="50%" Height="24px" Class="!bg-white/5" />
            </div>
        </div>
    }
</div>