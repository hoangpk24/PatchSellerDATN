@page "/cart/detail"
@layout MainLayout

<PageTitle>@Constant.PageTitleUser Cart Detail</PageTitle>

<section>
    <div class="w-full bg-[#9797971c] py-6">
        <div class="mx-auto w-full max-w-[1520px] px-6">
            <h1 class="mb-2.5 font-medium leading-tight text-[44px] text-white">Giỏ hàng chi tiết</h1>
            <MudBreadcrumbs Class="custom-breadcrumb !p-0 !text-xs" Items="_itemBreadcrumbs" Separator="/" />
        </div>
    </div>

    <div class="mx-auto my-10 max-w-[1520px] px-2">
        <div class="flex justify-between lg:flex-row sm:flex-col md:flex-col lg:gap-8 md:gap-4 sm:gap-6">
            <div class="lg:w-2/3 md:w-full sm:w-full">
                @*giao dien PC*@
                <div class="overflow-x-auto sm:hidden">
                    <table class="w-full border-collapse text-left">
                        <thead>
                            <tr class="border-b border-white/10 text-sm uppercase tracking-wider text-white">
                                <th class="w-16 py-4 font-medium"></th>
                                <th class="min-w-[300px] py-4 text-center font-medium">Sản phẩm</th>
                                <th class="py-4 text-center font-medium">Giá</th>
                            </tr>
                        </thead>
                        <tbody class="text-white">
                            @foreach (var item in _lstCartItem)
                            {
                                <tr class="group border-b border-white/5">
                                    <td class="py-6">
                                        <button @onclick="@(() => Delete(item.CartItemId))" class="text-white/40 transition-colors hover:text-red-500">
                                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                                        </button>
                                    </td>
                                    <td class="py-6">
                                        <div class="flex items-center gap-6">
                                            <img src="@item.GameThumbnail" alt="game"
                                                 class="aspect-[3/4] w-20 rounded-md object-cover shadow-lg" />
                                            <div class="flex flex-col gap-1">
                                                <span class="cursor-pointer text-base font-medium transition-colors hover:text-purple-500">
                                                    @item.GameTitle
                                                </span>
                                                <span class="cursor-pointer text-sm font-medium text-white/70 transition-colors hover:text-purple-500">
                                                    Gói: @item.PatchName
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="py-6 text-center text-white/80">
                                        @item.PatchPrice.ToString("C0", vietnameseCulture)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @*giao dien mobile*@
                <div class="hidden sm:block xs:block">
                    @foreach (var item in _lstCartItem)
                    {
                        <div class="relative flex flex-col border-b border-white/10 py-6 last:border-0">
                            <button @onclick="@(() => Delete(item.CartItemId))" class="absolute right-0 top-6 text-white/40">
                                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                            </button>

                            <div class="flex gap-4">
                                <img src="@item.GameThumbnail" class="aspect-[1/1.2] w-24 rounded object-cover shadow-lg" />

                                <div class="flex flex-1 flex-col gap-3">
                                    <h4 class="pr-6 text-base font-bold leading-tight text-white">@item.GameTitle</h4>
                                    <h4 class="pr-6 text-sm font-medium leading-tight text-white/70">@item.PatchName</h4>
                                    <div class="flex items-center justify-between border-t border-dashed border-white/10 pt-2">
                                        <span class="text-xs uppercase text-white/50">Giá</span>
                                        <span class="text-sm font-medium text-white">@item.PatchPrice.ToString("C0", vietnameseCulture)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="h-fit w-1/3 rounded-md bg-[#9797971c] p-7 md:w-full sm:w-full">
                <h3 class="mb-5 text-xl font-medium text-white">Đơn hàng</h3>
                <div class="flex justify-between gap-2">
                    <span class="w-36 flex-shrink-0 text-base font-medium text-white">Tạm tính:</span>
                    <span class="w-[calc(100%-144px)] whitespace-pre-wrap text-right text-base text-white/70">@(_lstCartItem.Any() ? _lstCartItem.Sum(x => x.PatchPrice).ToString("C0", vietnameseCulture) : "0đ")</span>
                </div>
                <MudDivider Class="my-6 !border-white/15" />
                <div class="flex justify-between gap-2">
                    <span class="w-36 flex-shrink-0 text-2xl font-medium text-white">Tổng tiền:</span>
                    <span class="w-[calc(100%-144px)] whitespace-pre-wrap text-right text-2xl font-bold text-purple-500">@(_lstCartItem.Any() ? _lstCartItem.Sum(x => x.PatchPrice).ToString("C0", vietnameseCulture) : "0đ")</span>
                </div>
                <MudDivider Class="my-6 !border-white/15" />
                <MudButton OnClick="OnCheckout" Disabled="@(_isLoading || !_lstCartItem.Any())" Variant="Variant.Filled" FullWidth Class="!rounded-full !bg-purple-500 !py-3 !text-white">
                    Tiến hành thanh toán
                </MudButton>
            </div>
        </div>
    </div>
</section>

<section class="mx-auto mb-10 mt-10 max-w-[1520px] px-3 lg:px-0">
    <div class="mb-6 flex items-center gap-2">
        <MudIcon Icon="@Icons.Material.Filled.Favorite" Class="!text-purple-500" Size="Size.Large" />
        <h2 class="text-2xl font-bold text-white xs:text-2xl">Có Thể Bạn Thích</h2>
    </div>

    <div class="hide-scrollbar flex flex-nowrap gap-4 overflow-x-auto rounded-md px-3">
        @for (int i = 0; i < 6; i++)
        {
            <div class="group relative flex-shrink-0 overflow-hidden lg:w-[calc(100%/6-1rem)] md:w-[327px] sm:w-[327px]">
                <a href="@RouterConfig.Customer.Home" class="flex h-full w-full flex-col gap-4">
                    <img src="https://avigames.net/wp-content/uploads/2025/07/wuchangavi.jpg" alt="product" class="aspect-[1/1.5] object-cover" />

                    <p class="line-clamp-2 text-base font-medium text-white">Wuchang: Fallen Feathers – Deluxe Edition</p>

                    <p class="text-base text-purple-500">100.000đ</p>
                </a>

                <div class="absolute right-2 top-2 translate-x-12 opacity-0 transition-all duration-300 ease-in-out group-hover:translate-x-0 group-hover:opacity-100">
                    <div class="flex flex-col gap-3 rounded-md bg-black-default2 p-2">
                        <MudIcon Class="cursor-pointer !text-white transition-colors hover:!text-purple-500" Icon="@Icons.Material.Filled.Search" />
                        <MudIcon Class="cursor-pointer !text-white transition-colors hover:!text-purple-500" Icon="@Icons.Material.Filled.FavoriteBorder" />
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    [CascadingParameter( Name = Constant.CascadingNameParams.Mine)]
    public MineResponse _mine { get; set; }

    [CascadingParameter(Name = Constant.CascadingNameParams.Token)]
    public string _token { get; set; }

    List<CartItemDetailResponse> _lstCartItem = [];

    bool _isLoading = false;

    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            await LoadData();
        } catch(Exception) {}
        finally
        {
            _isLoading = false;
        }
    }
    async Task LoadData()
    {
        var res = await _cartService.GetCart(_mine.Id);

        if(res.IsSuccess)
        {
            _lstCartItem = res.Data;
        }
    }

    async Task Delete(int id)
    {
        if (id <= 0) return;

        var res = await _cartItemService.Delete(id, _token);

        if(res)
        {
            _snackbar.Add("Xóa thành công!", MudBlazor.Severity.Success);
            await _cartActionService.LoadCartAsync(_mine.Id);
            await LoadData();
        } else
        {
            _snackbar.Add("Đã có lỗi xảy ra, vui lòng thử lại!", MudBlazor.Severity.Error);
        }
    }

    void OnCheckout()
    {
        if (_isLoading) return;

        if(!_lstCartItem.Any())
        {
            _snackbar.Add("Không có sản phẩm để thanh toán. Vui lòng chọn mua thêm", MudBlazor.Severity.Warning);
            return;
        }

        navigation.NavigateTo(RouterConfig.Customer.Checkout);
    }

    private List<BreadcrumbItem> _itemBreadcrumbs = [
        new("TRANG CHỦ", href: RouterConfig.Customer.Home),
        new("GIỎ HÀNG CHI TIẾT", href: null, disabled: true),
    ];
}

<style>
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
</style>