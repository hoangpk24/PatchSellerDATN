@page "/forgot-password"
@layout MainLayout

<section>
    <div class="w-full bg-[#9797971c] py-6">
        <div class="mx-auto w-full max-w-[1520px] px-6">
            <h1 class="mb-2.5 font-medium leading-tight text-[44px] text-white">Tài khoản</h1>
            <MudBreadcrumbs Class="custom-breadcrumb !p-0 !text-xs" Items="_itemBreadcrumbs" Separator="/" />
        </div>
    </div>

    <div class="mx-auto my-10 max-w-[500px] px-6">
        <h2 class="text-base font-medium text-white">Quên mật khẩu? Vui lòng nhập địa chỉ email. Bạn sẽ nhận được một mật khẩu tạm thời qua email.</h2>

        <MudDivider Class="my-4 !border-white/15" />
        <MudForm Model="@_model" @ref="@_form" Validation="@_forgotSchema.ValidateValue">
            <div class="mb-5">
                <label class="mb-2 block text-sm font-medium text-white">
                    Email
                </label>
                <MudTextField T="string"
                              @bind-Value="_model.Email"
                              For="@(() => _model.Email)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="custom-text-field" />
            </div>

            <MudButton Variant="Variant.Filled"
                       OnClick="@(async () => await OnSubmit())"
                       Class="w-full !rounded-full !bg-purple-500 py-2 !font-bold !text-white transition-all hover:!bg-purple-600">
                Đặt Lại Mật Khẩu
            </MudButton>
        </MudForm>

        <div class="mt-6 flex w-full max-w-[500px] items-center justify-between gap-2 border-t border-solid border-white/15 pt-4">
            <a href="@RouterConfig.Customer.Login" Class="w-[calc(50%-4px)] mt-4 flex h-10 flex-shrink-0 items-center justify-center rounded-full border border-solid border-purple-500 font-bold uppercase text-purple-500 hover:bg-purple-500 hover:text-white">
                Đăng Nhập
            </a>
            <a href="@RouterConfig.Customer.SignUp" Class="w-[calc(50%-4px)] mt-4 flex h-10 flex-shrink-0 items-center justify-center rounded-full border border-solid border-purple-500 font-bold uppercase text-purple-500 hover:bg-purple-500 hover:text-white">
                Đăng Ký
            </a>
        </div>
    </div>
</section>

@code {
    MudForm _form = new MudForm();
    ForgotModel _model = new ForgotModel();
    AccessSchema.ForgotPassword _forgotSchema = new AccessSchema.ForgotPassword();

    private List<BreadcrumbItem> _itemBreadcrumbs = [
        new("TRANG CHỦ", href: "/"),
        new("QUÊN MẬT KHẨU", href: null, disabled: true),
    ];

    private async Task OnSubmit()
    {
        await _form.Validate();

        if (!_form.IsValid) return;

        _model.Email = _model.Email.Trim();
        var response = await _accessService.ForgotPassword(_model);
        _snackbar.Add("Nếu địa chỉ email bạn vừa cung cấp tồn tại trong hệ thống của chúng tôi, một email chứa mật khẩu mới đã được gửi đi.", MudBlazor.Severity.Success);
        navigation.NavigateTo(RouterConfig.Customer.Login);
    }
}

<style>
    .mud-input-outlined-border {
        border-color: rgba(156, 163, 175, 0.3) !important;
        border-radius: 9999px !important;
    }

    .mud-input-outlined {
        background-color: #242424 !important;
        border-radius: 9999px !important;
        color: white !important;
    }

    .mud-icon-button-label svg {
        margin: 0 !important;
        height: 100%;
        color: #a855f7 !important;
    }
</style>