@page "/login"
@layout MainLayout

<section>
    <div class="w-full bg-[#9797971c] py-6">
        <div class="mx-auto w-full max-w-[1520px] px-6">
            <h1 class="mb-2.5 font-medium leading-tight text-[44px] text-white">Tài khoản</h1>
            <MudBreadcrumbs Class="custom-breadcrumb !p-0 !text-xs" Items="_itemBreadcrumbs" Separator="/" />
        </div>
    </div>

    <div class="mx-auto my-10 max-w-[500px] px-6">
        <h2 class="mb-8 font-medium uppercase text-[22px] text-white">Đăng Nhập</h2>

        <MudForm Model="@_model" @ref="@_form" Validation="@_loginSchema.ValidateValue">
            <div class="mb-5">
                <label class="mb-2 block text-sm font-medium text-white">
                    Tên tài khoản hoặc địa chỉ email
                </label>
                <MudTextField T="string"
                              @bind-Value="_model.UserName"
                              For="@(() => _model.UserName)"
                              Placeholder="example@gmail.com"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-2">
                <label class="mb-2 block text-sm font-medium text-white">
                    Mật khẩu
                </label>
                <MudTextField T="string"
                              @bind-Value="_model.PasswordHash"
                              For="@(() => _model.PasswordHash)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Placeholder="******"
                              InputType="@(_passwordVisibility ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_passwordVisibility ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="TogglePasswordVisibility"
                              AdornmentAriaLabel="Show Password" />
            </div>

            <div class="mb-3">
                <a href="@RouterConfig.Customer.ForgotPassword" class="text-xs font-medium text-purple-500 transition-colors hover:text-purple-600">
                    Quên mật khẩu?
                </a>
            </div>

            <MudButton Variant="Variant.Filled"
                       OnClick="@(async () => await OnSubmit())"
                       Disabled="@_isSubmitting"
                       Class="w-full !rounded-full !bg-purple-500 py-2 !font-bold !text-white transition-all hover:!bg-purple-600">
                Đăng Nhập
            </MudButton>

            <a href="@RouterConfig.Customer.SignUp" Class="mt-4 flex h-10 items-center justify-center rounded-full border border-solid border-purple-500 font-bold uppercase text-purple-500 hover:bg-purple-500 hover:text-white">
                Đăng Ký
            </a>
        </MudForm>
    </div>
</section>

@code {
    MudForm _form = new MudForm();
    LoginModel _model = new LoginModel();
    AccessSchema.Login _loginSchema = new AccessSchema.Login();

    private bool _isSubmitting = false;
    private bool _passwordVisibility = false;

    private List<BreadcrumbItem> _itemBreadcrumbs = [
        new("TRANG CHỦ", href: RouterConfig.Customer.Home),
        new("ĐĂNG NHẬP", href: null, disabled: true),
    ];

    private void TogglePasswordVisibility() => _passwordVisibility = !_passwordVisibility;

    private async Task OnSubmit()
    {
        if (_isSubmitting) return;

        try
        {
            _isSubmitting = true;
            await _form.Validate();

            if (!_form.IsValid) return;

            _model.UserName = _model.UserName.Trim();
            _model.PasswordHash = _model.PasswordHash.Trim();

            var result = await _accessService.LoginCustomer(_model);

            if (result.LoginSuccess == true)
            {
                await _localStorage.SetItemAsync(Constant.TokenNameLocalStorage, result.Token);
                await _localStorage.SetItemAsync(Constant.TokenExpiredLocalStorage, result.Expiration);
                await _localStorage.SetItemAsync(Constant.UserFirstLoginLocalStorage, result.FirstLogin);

               _snackbar.Add("Đăng nhập thành công!", MudBlazor.Severity.Success);
                navigation.NavigateTo(RouterConfig.Customer.Home);

            }
            else
            {
                _snackbar.Add("Đăng nhập không thành công. Vui lòng kiểm tra lại tài khoản và mật khẩu", MudBlazor.Severity.Warning);
            }
        }
        catch (Exception)
        {
            _isSubmitting = false;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}

<style>
    .mud-input-outlined-border {
        border-color: rgba(156, 163, 175, 0.3) !important;
        border-radius: 9999px !important;
    }

    .mud-input-outlined {
        background-color: #242424 !important;
        border-radius: 9999px !important;
        color: white !important;
    }

    .mud-icon-button-label svg {
        margin: 0 !important;
        height: 100%;
        color: #a855f7 !important;
    }
</style>