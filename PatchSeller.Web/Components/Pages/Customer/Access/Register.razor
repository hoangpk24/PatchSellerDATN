@page "/register"
@layout MainLayout

<section>
    @* Header Page *@
    <div class="w-full bg-[#9797971c] py-6">
        <div class="mx-auto w-full max-w-[1520px] px-6">
            <h1 class="mb-2.5 font-medium leading-tight text-[44px] text-white">Tài khoản</h1>
            <MudBreadcrumbs Class="custom-breadcrumb !p-0 !text-xs" Items="_itemBreadcrumbs" Separator="/" />
        </div>
    </div>

    <div class="mx-auto my-10 max-w-[500px] px-6">
        <h2 class="mb-8 font-medium uppercase text-[22px] text-white">Đăng Ký</h2>

        <MudForm Model="@_model" @ref="@_form" Validation="@_registerSchema.ValidateValue">
            <div class="mb-5">
                <label class="mb-2 block text-sm font-medium text-white">
                    Họ và tên
                </label>
                <MudTextField T="string"
                              @bind-Value="_model.FullName"
                              For="@(() => _model.FullName)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>
            <div class="mb-5">
                <label class="mb-2 block text-sm font-medium text-white">
                    Email
                </label>
                <MudTextField T="string"
                              @bind-Value="_model.Email"
                              For="@(() => _model.Email)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="custom-text-field" />
            </div>
            <div class="mb-5">
                <label class="mb-2 block text-sm font-medium text-white">
                    Số điện thoại
                </label>
                <MudTextField T="string"
                              @bind-Value="_model.PhoneNumber"
                              For="@(() => _model.PhoneNumber)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="custom-text-field" />
            </div>
            <div class="mb-5">
                <label class="mb-2 block text-sm font-medium text-white">
                    Tên đăng nhập
                </label>
                <MudTextField T="string"
                              @bind-Value="_model.UserName"
                              For="@(() => _model.UserName)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>
            <div class="mb-5">
                <label class="mb-2 block text-sm font-medium text-white">
                    Mật khẩu
                </label>
                <MudTextField T="string"
                              @bind-Value="_model.PasswordHash"
                              For="@(() => _model.PasswordHash)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@(_passwordVisibility ? InputType.Text : InputType.Password)"
                              Class="custom-text-field"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_passwordVisibility ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="TogglePasswordVisibility"
                              AdornmentAriaLabel="Show Password" />
            </div>

            <MudButton Variant="Variant.Filled"
                       OnClick="@(async () => await OnSubmit())"
                       Class="w-full !rounded-full !bg-purple-500 py-2 !font-bold !text-white transition-all hover:!bg-purple-600">
                Đăng Ký
            </MudButton>

            <a href="@RouterConfig.Customer.Login" Class="mt-4 flex h-10 items-center justify-center rounded-full border border-solid border-purple-500 font-bold uppercase text-purple-500 hover:bg-purple-500 hover:text-white">
                Đăng Nhập
            </a>
        </MudForm>
    </div>
</section>

@code {
    private MudForm _form = new MudForm();
    RegisterModel _model = new RegisterModel();
    AccessSchema.Register _registerSchema = new AccessSchema.Register();

    private bool _passwordVisibility = false;
    private bool _passwordConfirmVisibility = false;

    private List<BreadcrumbItem> _itemBreadcrumbs = [
        new("TRANG CHỦ", href: "/"),
        new("ĐĂNG KÝ", href: null, disabled: true),
    ];

    private void TogglePasswordVisibility() => _passwordVisibility = !_passwordVisibility;
    private void TogglePasswordConfirmVisibility() => _passwordConfirmVisibility = !_passwordConfirmVisibility;

    private async Task OnSubmit()
    {
        await _form.Validate();

        if (!_form.IsValid) return;

        _snackbar.Add("Submitted", MudBlazor.Severity.Success);
    }
}

<style>
    .mud-input-outlined-border {
        border-color: rgba(156, 163, 175, 0.3) !important;
        border-radius: 9999px !important;
    }

    .mud-input-outlined {
        background-color: #242424 !important;
        border-radius: 9999px !important;
        color: white !important;
    }

    .mud-icon-button-label svg {
        margin: 0 !important;
        height: 100%;
        color: #a855f7 !important;
    }
</style>
