@page "/change-password"
@layout MainLayout

<PageTitle>@Constant.PageTitleUser Reset Password</PageTitle>

<section>
    <div class="w-full bg-[#9797971c] py-6">
        <div class="mx-auto w-full max-w-[1520px] px-6">
            <h1 class="mb-2.5 font-medium leading-tight text-[44px] text-white">Tài khoản</h1>
        </div>
    </div>

    <div class="mx-auto my-10 max-w-[500px] px-6">
        <h2 class="mb-8 font-medium uppercase text-[22px] text-white">Đổi mật khẩu</h2>

        <MudForm Model="@_model" @ref="@_form" Validation="@_resetSchema.ValidateValue">
            <div class="mb-2">
                <label class="mb-2 block text-sm font-medium text-white">
                    Mật khẩu hiện tại
                </label>
                <MudTextField T="string"
                              @bind-Value="_model.CurrentPassword"
                              For="@(() => _model.CurrentPassword)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@(_isPasswordVisibleCurrent ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_isPasswordVisibleCurrent ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="ToggleCurrentPassword"
                              AdornmentAriaLabel="Show Password" />
            </div>

            <div class="mb-2">
                <label class="mb-2 block text-sm font-medium text-white">
                    Mật khẩu mới
                </label>
                <MudTextField T="string"
                              @bind-Value="_model.NewHashPassword"
                              For="@(() => _model.NewHashPassword)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@(_isPasswordVisibleNew ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_isPasswordVisibleNew ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="ToggleNewPassword"
                              AdornmentAriaLabel="Show Password" />
            </div>

            <div class="mb-2">
                <label class="mb-2 block text-sm font-medium text-white">
                    Xác nhận mật khẩu mới
                </label>
                <MudTextField T="string"
                              @bind-Value="_model.ConfirmNewPassword"
                              For="@(() => _model.ConfirmNewPassword)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@(_isPasswordVisibleConfirmNew ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_isPasswordVisibleConfirmNew ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="ToggleConfirmNewPassword"
                              AdornmentAriaLabel="Show Password" />
            </div>

            <MudButton Variant="Variant.Filled"
                       OnClick="@(async () => await OnSubmit())"
                       Disabled="@_isSubmitting"
                       Class="w-full !rounded-full !bg-purple-500 py-2 !font-bold !text-white transition-all hover:!bg-purple-600">
                Lưu
            </MudButton>
        </MudForm>
    </div>
</section>

@code {
    [CascadingParameter(Name = Constant.CascadingNameParams.Token)]
    public string _token { get; set; }

    MudForm _form = new MudForm();
    AccessSchema.ResetPassword _resetSchema = new AccessSchema.ResetPassword();
    CustomerChangePasswordModel _model = new CustomerChangePasswordModel();

    private bool _isSubmitting = false;
    private bool _isPasswordVisibleCurrent = false;
    private bool _isPasswordVisibleNew = false;
    private bool _isPasswordVisibleConfirmNew = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var FirstLogin = await _localStorage.GetItemAsStringAsync(Constant.UserFirstLoginLocalStorage);

            if (string.IsNullOrEmpty(FirstLogin))
            {
                navigation.NavigateTo(RouterConfig.Customer.Home);
            }
            else
            {
                if (!bool.Parse(FirstLogin))
                {
                    navigation.NavigateTo(RouterConfig.Customer.Home);
                }
            }
        }
    }

    private void ToggleCurrentPassword() => _isPasswordVisibleCurrent = !_isPasswordVisibleCurrent;
    private void ToggleNewPassword() => _isPasswordVisibleNew = !_isPasswordVisibleNew;
    private void ToggleConfirmNewPassword() => _isPasswordVisibleConfirmNew = !_isPasswordVisibleConfirmNew;

    private async Task OnSubmit()
    {

        if (_isSubmitting) return;

        if (_model.NewHashPassword != _model.ConfirmNewPassword)
        {
            _snackbar.Add("Mật khẩu mới không khớp", MudBlazor.Severity.Error);
            return;
        }

        try
        {
            _isSubmitting = true;
            await _form.Validate();

            if (!_form.IsValid) return;

            var response = await _accessService.ChangePassword(_model, _token);

            if (response.IsSuccess)
            {
                await _localStorage.RemoveItemAsync(Constant.UserFirstLoginLocalStorage);
                await _localStorage.SetItemAsync(Constant.UserFirstLoginLocalStorage, false);

                _snackbar.Add("Đổi mật khẩu thành công", MudBlazor.Severity.Success);
                navigation.NavigateTo(RouterConfig.Customer.Home);

            }
            else
            {
                _snackbar.Add(response.ErrorMessage, MudBlazor.Severity.Warning);
            }
        }
        catch (Exception)
        {
            _isSubmitting = false;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}

<style>
    .mud-input-outlined-border {
        border-color: rgba(156, 163, 175, 0.3) !important;
        border-radius: 9999px !important;
    }

    .mud-input-outlined {
        background-color: #242424 !important;
        border-radius: 9999px !important;
        color: white !important;
    }

    .mud-icon-button-label svg {
        margin: 0 !important;
        height: 100%;
        color: #a855f7 !important;
    }
</style>