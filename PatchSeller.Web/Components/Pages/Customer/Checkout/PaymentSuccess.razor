@page "/order/payment-success"
@layout MainLayout

<section>
    <div class="w-full bg-[#9797971c] py-6">
        <div class="mx-auto w-full max-w-[1520px] px-6">
            <h1 class="mb-2.5 font-medium leading-tight text-[44px] text-white">Thanh Toán</h1>
            <MudBreadcrumbs Class="custom-breadcrumb !p-0 !text-xs" Items="_itemBreadcrumbs" Separator="/" />
        </div>
    </div>
    <div class="flex w-full flex-col items-center justify-center gap-4 rounded-lg p-6 text-center shadow">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="!text-4xl !text-purple-500" />
        <h2 class="text-2xl font-bold text-white">Đặt hàng thành công!</h2>
        <p class="text-base text-white/70"><span class="font-bold">Mã hóa đơn:</span> @_orderCodeSuccess</p>
        <div class="flex justify-center gap-3">
            <MudButton Variant="Variant.Filled" Class="!bg-purple-500" OnClick="@(() => navigation.NavigateTo(RouterConfig.Customer.Home))">Tiếp tục mua sắm</MudButton>
            <MudButton Variant="Variant.Outlined" Class="!border-white/70 !text-white/70" OnClick="@(() => navigation.NavigateTo(RouterConfig.Customer.Profile))">Xem hóa đơn</MudButton>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "order-id")]
    public int _orderId { get; set; } = 0;

    [CascadingParameter(Name = Constant.CascadingNameParams.Token)]
    public string _token { get; set; }

    private int _orderIdSuccess = -1;
    private string _orderCodeSuccess = string.Empty;

    private List<BreadcrumbItem> _itemBreadcrumbs = [
        new("TRANG CHỦ", href: RouterConfig.Customer.Home),
        new("THANH TOÁN", href: null, disabled: true),
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        StateHasChanged();
    }

    async Task LoadData()
    {
        if (_orderId > 0)
        {
            _orderIdSuccess = _orderId;
            var result = await _orderService.PaymentSuccess(_orderId, _token);
            if (result.IsSuccess)
            {
                _orderCodeSuccess = result.Data.OrderCode;
            }
        }
    }
}
