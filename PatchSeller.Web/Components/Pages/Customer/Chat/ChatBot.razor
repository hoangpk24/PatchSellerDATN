@using System.Net.Http.Json
@rendermode InteractiveServer

<style>
    .chatbot-fab {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .chatbot-fab:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
    }

    .chat-box-container {
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        transform-origin: bottom right;
        opacity: 0;
        transform: scale(0.8) translateX(20px);
        pointer-events: none;
        visibility: hidden;
    }

    .chat-box-container.open {
        opacity: 1;
        transform: scale(1) translateX(0);
        pointer-events: auto;
        visibility: visible;
    }

    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }

    .message-appear {
        animation: slideUp 0.3s ease-out forwards;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .typing-dot {
        width: 6px;
        height: 6px;
        margin: 0 1px;
        background-color: #9ca3af;
        border-radius: 50%;
        display: inline-block;
        animation: typing 1.4s infinite both;
    }

    .typing-dot:nth-child(2) {
        animation-delay: 0.2s;
    }

    .typing-dot:nth-child(3) {
        animation-delay: 0.4s;
    }

    @@keyframes typing {
        0%, 80%, 100% {
            transform: scale(0.6);
            opacity: 0.4;
        }

        40% {
            transform: scale(1.2);
            opacity: 1;
        }
    }
</style>

<div class="fixed bottom-5 right-10 z-50 flex items-end gap-3">
    <div class="chat-box-container @(_isOpen ? "open" : "") mb-2 w-[400px] overflow-hidden rounded-2xl border border-white/10 bg-[#1a1a1a] shadow-2xl">
        <div class="flex items-center justify-between bg-gradient-to-r from-[#667eea] to-[#764ba2] p-4 text-white">
            <div class="flex items-center gap-3">
                <div class="relative">
                    <MudAvatar Color="Color.Info" Variant="Variant.Filled" Size="Size.Medium">AI</MudAvatar>
                    <span class="absolute bottom-0 right-0 h-3 w-3 rounded-full border-2 border-[#1a1a1a] bg-green-500"></span>
                </div>
                <div>
                    <p class="text-sm font-bold">Trợ lý ảo ITEAM</p>
                    <p class="text-[10px] opacity-80">Sẵn sàng hỗ trợ</p>
                </div>
            </div>
            <div class="flex items-center">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Inherit" Size="Size.Small" OnClick="ResetChat" />
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" Size="Size.Small" OnClick="OnToggleChat" />
            </div>
        </div>

        @* QUAN TRỌNG: id phải khớp với hàm JS *@
        <div id="chat-content" class="hide-scrollbar bg-[#111111]/50 h-[450px] space-y-4 overflow-y-auto p-4">
            @foreach (var msg in _messages)
            {
                <div class="message-appear @(msg.IsBot ? "justify-start" : "justify-end") flex">
                    <div class="max-w-[85%] rounded-2xl p-3 text-sm @(msg.IsBot ? "rounded-tl-none bg-[#2d2d2d] text-gray-200" : "rounded-tr-none bg-purple-600 text-white shadow-md")">
                        @if (msg.IsTyping)
                        {
                            <div class="flex h-5 items-center">
                                <span class="typing-dot"></span>
                                <span class="typing-dot"></span>
                                <span class="typing-dot"></span>
                            </div>
                        }
                        else
                        {
                            @((MarkupString)msg.Text)

                            @if (msg.Options != null && msg.Options.Any())
                            {
                                <div class="mt-3 flex flex-wrap gap-2">
                                    @foreach (var opt in msg.Options)
                                    {
                                        <button @onclick="() => OnSelectOption(opt)"
                                                class="rounded-lg border border-purple-500/50 bg-purple-500/10 px-3 py-1.5 text-[11px] text-purple-300 transition-all hover:bg-purple-500 hover:text-white">
                                            @opt.Text
                                        </button>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        <div class="border-t border-white/5 bg-[#1a1a1a] p-4 text-center">
            <p class="uppercase tracking-widest text-[10px] text-gray-500">Hệ thống trả lời tự động</p>
        </div>
    </div>

    <div class="chatbot-fab flex h-14 w-14 cursor-pointer items-center justify-center rounded-full shadow-2xl" @onclick="OnToggleChat">
        <MudIcon Icon="@(_isOpen? Icons.Material.Filled.Close : Icons.Material.Filled.Chat)" Class="text-white" Size="Size.Medium" />
    </div>
</div>

@code {
    private bool _isOpen = false;
    private List<ChatBotResponse> _messages = new();
    private List<ChatNodeResponse> _allData = new();

    public class ChatBotResponse
    {
        public string Text { get; set; } = "";
        public bool IsBot { get; set; }
        public bool IsTyping { get; set; }
        public List<ChatNodeResponse>? Options { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        ResetChat();
    }

    private async Task LoadData()
    {
        try
        {
            using var client = new HttpClient { BaseAddress = new Uri(navigation.BaseUri) };
            var data = await client.GetFromJsonAsync<List<ChatNodeResponse>>("assets/chatbot_data.json");
            if (data != null) _allData = data;
        }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
    }

    private async Task OnToggleChat()
    {
        _isOpen = !_isOpen;
        if (_isOpen) await ScrollToBottom();
    }

    private void ResetChat()
    {
        _messages.Clear();
        _messages.Add(new ChatBotResponse { IsBot = true, Text = "Xin chào! Tôi là trợ lý ITEAM. Bạn cần hỗ trợ gì?", Options = _allData });
    }

    private async Task ScrollToBottom()
    {
        await Task.Delay(100);
        await JS.InvokeVoidAsync("scrollToBottom", "chat-content");
    }

    private async Task OnSelectOption(ChatNodeResponse node)
    {
        _messages.Add(new ChatBotResponse { IsBot = false, Text = node.Text });
        StateHasChanged();
        await ScrollToBottom();

        var typing = new ChatBotResponse { IsBot = true, IsTyping = true };
        _messages.Add(typing);
        StateHasChanged();
        await ScrollToBottom();

        await Task.Delay(800);

        _messages.Remove(typing);
        var botReply = new ChatBotResponse { IsBot = true };

        if (!string.IsNullOrEmpty(node.Response))
        {
            botReply.Text = node.Response;
            botReply.Options = new List<ChatNodeResponse> { new ChatNodeResponse { Text = "Quay lại từ đầu", Id = 0 } };
        }
        else if (node.Children != null && node.Children.Any())
        {
            botReply.Text = "Bạn cần hỗ trợ cụ thể về:";
            botReply.Options = node.Children;
        }
        else
        {
            botReply.Text = "Tôi có thể giúp gì thêm không?";
            botReply.Options = _allData;
        }

        _messages.Add(botReply);
        StateHasChanged();
        await ScrollToBottom();
    }
}

<script>
    window.scrollToBottom = (elementId) => {
        var elem = document.getElementById(elementId);
        if (elem) {
            elem.scrollTo({
                top: elem.scrollHeight,
                behavior: 'smooth'
            });
        }
    };
</script>