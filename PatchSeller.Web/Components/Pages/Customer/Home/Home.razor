@page "/"

<PageTitle>@Constant.PageTitleUser Home</PageTitle>

<section class="relative mt-6 overflow-hidden rounded-2xl shadow-2xl shadow-purple-500/10">
    <MudCarousel Class="mud-width-full aspect-[16/9]"
                    ShowArrows="true"
                    ShowBullets="false"
                    AutoCycle="true"
                    ItemsSource="@_itemSliders">
        <ItemTemplate>
            <img src="@context"
                    alt="banner"
                    class="h-full w-full object-cover" />                        
        </ItemTemplate>
    </MudCarousel>
</section>

<section class="mt-6"></section>

@code {
    private IList<string> _itemSliders = new List<string>()
    {
        "/assets/images/banner.jpg",
        "/assets/images/banner-2.jpg",
        "/assets/images/banner-3.jpg",
        "/assets/images/banner-4.jpg",
        "/assets/images/banner-5.jpg",
        "/assets/images/banner-6.jpg"
    };
}