@page "/"

<PageTitle>@Constant.PageTitleUser Home</PageTitle>

@if (_isLoading)
{
    <div class="absolute bottom-0 left-0 right-0 top-0 z-20 overflow-hidden bg-black/50">
        <Loading />
    </div>
}

<section class="relative mx-auto max-w-[1520px] overflow-hidden rounded-2xl shadow-2xl shadow-purple-500/10 xs:mx-4 sm:mx-4 md:mt-6 lg:mt-6 sm:mt-0">
    <MudCarousel Class="mud-width-full aspect-[16/9] sm:aspect-[4/2.25] xs:aspect-[4/2.25]"
                 ShowArrows="true"
                 ShowBullets="false"
                 AutoCycle="true"
                 ItemsSource="@_itemSliders">
        <ItemTemplate>
            <img src="@context"
                 alt="banner"
                 class="h-full w-full object-cover" />
        </ItemTemplate>
    </MudCarousel>
</section>

@if (_gameForHome.LstCommingSoon.Any())
{
    <section class="mx-auto mb-10 mt-10 max-w-[1520px] px-3 lg:px-0">
        <div class="mb-6 flex items-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Games" Class="!text-purple-500" Size="Size.Large" />
            <h2 class="text-2xl font-bold text-white xs:text-2xl">Sắp Ra Mắt</h2>
        </div>

        <div class="hide-scrollbar flex flex-nowrap gap-4 overflow-x-auto rounded-md px-3">
                @foreach (var item in _gameForHome.LstCommingSoon)
                {
                    @if(item != null)
                    {
                        <div class="group relative flex-shrink-0 overflow-hidden lg:w-[calc(100%/6-1rem)] md:w-[327px] sm:w-[327px]">
                            <a href="@RouterConfig.Customer.Game.Replace(":id", item.GameId.ToString())" class="flex h-full w-full flex-col gap-4">
                                <img src="@item.Thumbnail" alt="game" class="aspect-[1/1.5] object-cover" />

                                <p class="line-clamp-2 text-base font-medium text-white">@item.Title</p>
                            </a>
                        </div>
                    }
                }
        </div>
    </section>
}

<section class="mx-auto mt-10 max-w-[1520px] px-3 lg:px-0">
    <div class="mb-6 flex items-center gap-2">
        <MudIcon Icon="@Icons.Material.Filled.Whatshot" Class="!text-purple-500" Size="Size.Large" />
        <h2 class="text-2xl font-bold text-white xs:text-2xl">Hot Nhất</h2>
    </div>

    <div class="hide-scrollbar flex flex-nowrap gap-4 overflow-x-auto rounded-md border border-solid border-purple-500 px-3 py-4">
        @for(int i = 0; i< 6; i++)
        {
            <div class="group relative flex-shrink-0 overflow-hidden lg:w-[calc(100%/6-1rem)] md:w-[325px] sm:w-[325px]">
                <a href="@RouterConfig.Customer.Game" class="flex h-full w-full flex-col gap-4">
                    <img src="https://avigames.net/wp-content/uploads/2025/07/wuchangavi.jpg" alt="product" class="aspect-[1/1.5] object-cover" />

                    <p class="line-clamp-2 h-12 text-base font-medium text-white">Wuchang: Fallen Feathers – Deluxe Edition</p>

                    <p class="text-base text-purple-500">100.000đ</p>
                </a>

                <div class="absolute right-2 top-2 translate-x-12 opacity-0 transition-all duration-300 ease-in-out group-hover:translate-x-0 group-hover:opacity-100">
                    <div class="flex flex-col gap-3 rounded-md bg-black-default2 p-2">
                        <MudIcon Class="cursor-pointer !text-white transition-colors hover:!text-purple-500" Icon="@Icons.Material.Filled.Search" />
                        <MudIcon Class="cursor-pointer !text-white transition-colors hover:!text-purple-500" Icon="@Icons.Material.Filled.FavoriteBorder" />
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section class="mx-auto mb-10 mt-10 max-w-[1520px] px-3 lg:px-0">
    <div class="mb-6 flex items-center gap-2">
        <MudIcon Icon="@Icons.Material.Filled.Games" Class="!text-purple-500" Size="Size.Large" />
        <h2 class="text-2xl font-bold text-white xs:text-2xl">Mới Nhất</h2>
    </div>

    <div class="hide-scrollbar flex flex-nowrap gap-4 overflow-x-auto rounded-md px-3">
        @if(_gameForHome.LstNew.Any())
        {   
            @foreach(var item in _gameForHome.LstNew)
            {
                if(item != null)
                {
                    <div class="group relative flex-shrink-0 overflow-hidden lg:w-[calc(100%/6-1rem)] md:w-[327px] sm:w-[327px]">
                        <a href="@RouterConfig.Customer.Game.Replace(":id", item.GameId.ToString())" class="flex h-full w-full flex-col gap-4">
                            <img src="@item.Thumbnail" alt="game" class="aspect-[1/1.5] object-cover" />

                            <p class="line-clamp-2 h-12 text-base font-medium text-white">@item.Title</p>

                            <p class="truncate text-base font-bold text-purple-500" title="@GetPriceDisplay(item.Patches)">
                                @GetPriceDisplay(item.Patches)
                            </p>
                        </a>

                        <div class="absolute right-2 top-2 translate-x-12 opacity-0 transition-all duration-300 ease-in-out group-hover:translate-x-0 group-hover:opacity-100">
                            <div class="flex flex-col gap-3 rounded-md bg-black-default2 p-2">
                                <MudIcon @onclick="@(() => OpenDialogFastAddCart(item.GameId))" Class="cursor-pointer !text-white transition-colors hover:!text-purple-500" Icon="@Icons.Material.Filled.Search" />
                                <MudIcon Class="cursor-pointer !text-white transition-colors hover:!text-purple-500" Icon="@Icons.Material.Filled.FavoriteBorder" />
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>
</section>


<section class="mx-auto mb-4 mt-14 flex max-w-[1520px] justify-center px-3 lg:px-0">
    <div class="flex items-center gap-4 sm:gap-2 xs:gap-1">
        <div class="xs:hidden">
            <img src="/assets/images/wd-vgs-sw-j-stroke-w.png" alt="decor" class="h-auto w-16 md:w-12 sm:w-8" />
        </div>

        <MudButton Variant="Variant.Filled"
                   Href="@RouterConfig.Customer.Search"
                   Class="!rounded-full !bg-purple-500 px-12 py-3 text-lg font-bold !text-white transition-all hover:!bg-purple-600 hover:!shadow-[0_0_20px_rgba(109,74,255,0.5)] active:scale-95 sm:px-8 xs:px-6 sm:py-2 sm:text-base xs:text-sm">
            XEM TẤT CẢ CÁC GÓI
        </MudButton>

        <div class="xs:hidden">
            <img src="/assets/images/wd-vgs-sw-j-stroke-right.png" alt="decor" class="h-auto w-16 md:w-12 sm:w-8" />
        </div>
    </div>
</section>

<section class="mx-auto mb-6 mt-10 max-w-[1520px] px-3 lg:px-0">
    <div class="mb-6">
        <h2 class="text-2xl font-bold text-white xs:text-2xl">Bài Viết</h2>
    </div>

    <div class="grid grid-cols-3 gap-6 xs:grid-cols-1 sm:grid-cols-1 md:grid-cols-2">
        @foreach (var post in _posts)
        {
            <div class="group flex flex-col overflow-hidden rounded-xl bg-[#181818] transition-all hover:translate-y-[-4px]">
                <div class="relative aspect-video overflow-hidden">
                    <img src="@post.Thumbnail" alt="@post.Title" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" />
                    <div class="absolute bottom-3 left-3 z-10 flex items-center gap-2">
                        <MudAvatar Size="Size.Small" Image="/assets/images/user-avatar.png" />
                        <span class="text-xs font-medium text-white shadow-black drop-shadow-md">ezdigi</span>
                    </div>
                    <div class="absolute bottom-3 right-3 z-10 flex gap-2 text-white opacity-80">
                        <MudIcon Icon="@Icons.Material.Outlined.Share" Size="Size.Small" />
                        <div class="flex items-center gap-1">
                            <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Size="Size.Small" />
                            <span class="text-[10px]">0</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col p-5">
                    <div class="mb-2 flex items-center gap-2 font-semibold uppercase tracking-wider text-[11px] text-gray-500">
                        <span>@post.Category</span>
                        <span>/</span>
                        <span>@post.Date</span>
                    </div>
                    <h3 class="line-clamp-2 text-lg font-bold text-white transition-colors group-hover:text-purple-500">
                        @post.Title
                    </h3>
                </div>
            </div>
        }
    </div>
</section>

@code {
    [CascadingParameter(Name = Constant.CascadingNameParams.Mine)]
    public MineResponse _mine { get; set; }

    [CascadingParameter(Name = Constant.CascadingNameParams.Token)]
    public string _token { get; set; }

    GameForHomeResponse _gameForHome = new GameForHomeResponse();

    bool _isLoading = false;

    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            await LoadData();
        } 
        catch(Exception){}
        finally
        {
            _isLoading = false;
        }
    }

    async Task LoadData()
    {
        var resGame = await _gameService.GetAllForHome();

        if(resGame.IsSuccess)
        {
            _gameForHome = resGame.Data;
        }
    }

    private string GetPriceDisplay(List<PatchBasicDTO> patches)
    {
        if (patches == null || !patches.Any())
        {
            return "Liên hệ";
        }

        var prices = patches.Select(p => p.Price).OrderBy(p => p).ToList();
        double minPrice = prices.First();
        double maxPrice = prices.Last();

        string format = "C0";

        if (minPrice == maxPrice)
        {
            return minPrice <= 0 ? "Miễn phí" : $"{minPrice.ToString(format, vietnameseCulture)}";
        }

        return $"{minPrice.ToString(format, vietnameseCulture)} - {maxPrice.ToString(format, vietnameseCulture)}";
    }

    async Task OpenDialogFastAddCart(int gameId)
    {
        var paraeters = new DialogParameters<Components.Common.Customer.FastAddCart>
        {
            {x => x.gameId, gameId},
            {x => x.cartId, _mine.cartId},
            {x => x.userId, _mine.Id},
            {x => x.token, _token}
        };

        var dialog = await _dialogService.ShowAsync<Components.Common.Customer.FastAddCart>("Options Dialog", paraeters, _dialogOptions);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData();
            await _cartActionService.LoadCartAsync(_mine.Id);
            StateHasChanged();
        }
    }

    private IList<string> _itemSliders = new List<string>()
    {
        "/assets/images/banner.jpg",
        "/assets/images/banner-2.jpg",
        "/assets/images/banner-3.jpg",
        "/assets/images/banner-4.jpg",
        "/assets/images/banner-5.jpg",
        "/assets/images/banner-6.jpg"
    };

    private List<Common.PostModel> _posts = new()
    {
        new Common.PostModel {
            Title = "Cách tải Yuzu khi bị chặn",
            Category = "Chưa phân loại",
            Date = "04 Th5 2025",
            Thumbnail = "/assets/images/post.png"
        },
        new Common.PostModel {
            Title = "ITEAM hướng dẫn cách mua hàng - đặt dịch vụ trên website ITEAM",
            Category = "Bài viết",
            Date = "03 Th4 2025",
            Thumbnail = "/assets/images/post-2.jpg"
        },
        new Common.PostModel {
            Title = "Hướng dẫn cách vào Steam khi bị chặn bằng DNS trên PC Handheld hệ Windows - Bazzite và Steam Deck hệ SteamOS",
            Category = "Bài viết",
            Date = "03 Th1 2025",
            Thumbnail = "/assets/images/post-3.jpg"
        }
    };
}

<style>
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
</style>