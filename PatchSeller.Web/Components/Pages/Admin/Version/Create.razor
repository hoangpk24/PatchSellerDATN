@page "/admin/version/create"
@layout AdminLayout

<PageTitle>@Constant.PageTitleAdmin Patch Version Create</PageTitle>

@if(_isLoadingUpload)
{
    <div class="absolute bottom-0 left-0 right-0 top-0 z-20 bg-black/50">
        <Loading />    
    </div>
}

<section class="mx-auto max-w-[1280px] p-6">
    <h1 class="leading-[3rem] h-12 text-3xl font-bold text-material-default">Tạo phiên bản</h1>

    <div class="rounded bg-white p-10 shadow-md">
        <MudForm Model="_model" @ref="_form" Validation="_schema.ValidateValue">
            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Phiên bản</label> <span class="ml-1 text-red-500">*</span>

                <MudTextField T="string"
                              @bind-Value="_model.VersionName"
                              For="@(() => _model.VersionName)"
                              Variant="Variant.Outlined"
                              Placeholder="Ví dụ: v1.1..."
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Tóm tắt phiên bản</label> <span class="ml-1 text-red-500">*</span>

                <MudTextField T="string"
                              Lines="5"
                              @bind-Value="_model.Changelog"
                              For="@(() => _model.Changelog)"
                              Variant="Variant.Outlined"
                              Placeholder="Nhập tóm tắt ngắn gọn về phiên bản này..."
                              Margin="Margin.Dense" />
            </div>

            @* <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Mật khẩu giải nén</label>

                <MudTextField T="string"
                              @bind-Value="_model.ExtractionPassword"
                              For="@(() => _model.ExtractionPassword)"
                              Variant="Variant.Outlined"
                              Placeholder="Nhập mật khẩu nếu có..."
                              Margin="Margin.Dense" />
            </div> *@

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Quy trình cài đặt</label>

                <RichTextEditor @bind-Content="@_model.InstallationGuide"
                                Placeholder="Quy trình các bước cài đặt..."
                                ToolbarOptions="@ToolbarOptions.FullToolbarOptions"
                                Theme="@QuillTheme.Snow" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Thuộc gói</label> <span class="ml-1 text-red-500">*</span>

                <MudSelect T="int" @bind-Value="_model.PatchId" For="@(() => _model.PatchId)" Variant="Variant.Outlined" Placeholder="Riot Games" Margin="Margin.Dense">
                    <MudSelectItem Value="0">- Vui lòng chọn -</MudSelectItem>
                    @if (_lstPatch.Any())
                    {
                        @foreach (var item in _lstPatch)
                        {
                            <MudSelectItem Value="@item.PatchId">@item.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Nhân viên tạo</label> <span class="ml-1 text-red-500">*</span>

                <MudSelect T="int" @bind-Value="_model.StaffId" For="@(() => _model.StaffId)" Variant="Variant.Outlined" Placeholder="Riot Games" Margin="Margin.Dense">
                    <MudSelectItem Value="0">- Vui lòng chọn -</MudSelectItem>
                    @if (_lstStaff.Any())
                    {
                        @foreach (var item in _lstStaff)
                        {
                            <MudSelectItem Value="@item.StaffId">@item.FullName</MudSelectItem>
                        }
                    }
                </MudSelect>
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Ghi chú</label>

                <MudTextField T="string"
                              Lines="5"
                              @bind-Value="_model.Note"
                              For="@(() => _model.Note)"
                              Variant="Variant.Outlined"
                              Placeholder="Nhập ghi chú..."
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Tải lên file</label>

                <MudFileUpload T="IBrowserFile"
                               FilesChanged="@(async (file) => await UploadFile(file))"
                               Disabled="@(string.IsNullOrEmpty(_model.VersionName) || _model.PatchId == 0)">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(_uploadFileResponse != null || _isLoadingUpload || _isLoading || string.IsNullOrEmpty(_model.VersionName) || _model.PatchId == 0)"
                                   StartIcon="@Icons.Material.Filled.CloudUpload">
                            Upload Files
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>

                @if (string.IsNullOrEmpty(_model.VersionName) || _model.PatchId == 0)
                {
                    <p class="mt-1 text-xs italic text-amber-600">* Vui lòng chọn gói và nhập phiên bản trước khi upload.</p>
                }

                @if(_uploadFileResponse != null)
                {
                    <div class="mt-4 flex items-center gap-4 rounded border border-slate-200 bg-slate-50 p-4">
                        <div class="flex-1">
                            <div class="font-bold text-slate-700">@_fileName</div>
                            <div class="text-sm text-slate-500">Kích thước: @(_uploadFileResponse.SizeMb > 0 ? _uploadFileResponse.SizeMb + "mb" : _uploadFileResponse.Size + "kb")</div>
                        </div>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Disabled="@(_isLoading || _isLoadingUpload)"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="RemoveFileAsync">
                            Xóa file
                        </MudButton>
                    </div>
                }
                <div>

                </div>
            </div>

            <MudDivider Class="mb-8 mt-4 !border-slate-200" />

            <div class="flex items-center justify-end gap-3">
                <MudButton Variant="Variant.Text"
                           Class="px-6 py-2 text-slate-500 hover:bg-slate-200"
                           OnClick="() => navigation.NavigateTo(RouterConfig.Admin.Version)">
                    Quay lại
                </MudButton>
                <AuthorizeControl Action="@Constant.ActionButton.Create">
                    <MudButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Add"
                            OnClick="@(async () => await OnSubmit())"
                            Disabled="@(_isLoading || _isLoadingUpload)"
                            Class="px-8 py-2.5 font-bold shadow-lg shadow-material-default/20">
                        Tạo mới
                    </MudButton>
                </AuthorizeControl>
            </div>
        </MudForm>
    </div>
</section>

@code {
    [CascadingParameter(Name = Constant.CascadingNameParams.Token)]
    public string _token { get; set; }
    MudForm _form = new MudForm();
    UploadFileResponse _uploadFileResponse = null;
    List<PatchDetailResponse> _lstPatch = [];
    List<DAL.Models.Staff> _lstStaff = [];
    PatchVersionModel _model = new PatchVersionModel();
    PatchVersionSchema.CreateUpdate _schema = new PatchVersionSchema.CreateUpdate();

    bool _isLoading = false;
    string _fileName = string.Empty;
    bool _isLoadingUpload = false;
    string _content = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            await LoadData();
        }
        catch (Exception)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    async Task LoadData()
    {
        _model.PatchId = 0;
        var response = await _adminPatchService.GetAllWithDetail();
        if (response.IsSuccess)
        {
            _lstPatch = response.Data;
        }
        var responseStaff = await _adminStaffService.GetAll();
        if (responseStaff.IsSuccess)
        {
            _lstStaff = responseStaff.Data;
        }
    }

    private async Task UploadFile(IBrowserFile file)
    {
        if (file == null) return;

        if (_model.PatchId == 0 || string.IsNullOrWhiteSpace(_model.VersionName))
        {
            _snackbar.Add("Vui lòng chọn 'Thuộc gói' và nhập 'Phiên bản' trước khi upload để sắp xếp thư mục!", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _isLoadingUpload = true;
            long maxFileSize = 10L * 1024 * 1024 * 1024;
            var selectedPatch = _lstPatch.FirstOrDefault(x => x.PatchId == _model.PatchId);
            string gameName = selectedPatch?.Game != null && !string.IsNullOrEmpty(selectedPatch.Game.Title) ? selectedPatch.Game.Title :  "UnknownGame";

            string patchName = selectedPatch?.Name ?? "UnknownPatch";
            string version = _model.VersionName;

            using var stream = file.OpenReadStream(maxAllowedSize: maxFileSize);

            var res = await _adminUploadService.UploadPatchWithFolderAsync(
                stream,
                file.Name,
                gameName,
                patchName,
                version
            );

            if (res.IsSuccess)
            {
                _uploadFileResponse = res.Data;
                _fileName = file.Name;
                _model.Links = res.Data.Link;
                _model.FileSize = file.Size;
                _snackbar.Add("Tải file lên thành công!", MudBlazor.Severity.Success);
            }
            else
            {
                _snackbar.Add($"Lỗi upload: {res.ErrorMessage}", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _snackbar.Add($"Có lỗi xảy ra: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _isLoadingUpload = false;
            StateHasChanged();
        }
    }

    private async Task RemoveFileAsync()
    {
        if (_uploadFileResponse == null) return;

        try
        {
            _isLoadingUpload = true;

            var res = await _adminUploadService.DeleteFileAsync(_uploadFileResponse.Link);

            if(res.IsSuccess)
            {
                _snackbar.Add("Xóa file thành công!", MudBlazor.Severity.Success);
            }
            else
            {
                _snackbar.Add($"Lỗi xóa file: {res.ErrorMessage}", MudBlazor.Severity.Error);
            }
        } catch (Exception)
        {
        }
        finally
        {
            _isLoadingUpload = false;
            _uploadFileResponse = null;
            _fileName = string.Empty;
            _model.Links = string.Empty;
            _model.FileSize = 0;
            StateHasChanged();
        }
    }

    async Task OnSubmit()
    {
        if (_isLoadingUpload)
        {
            _snackbar.Add("Vui lòng đợi file tải lên hoàn tất", MudBlazor.Severity.Warning);
            return;
        }

        if( _uploadFileResponse == null)
        {
            _snackbar.Add("Vui lòng tải lên file trước khi tạo phiên bản", MudBlazor.Severity.Warning);
            return;
        }

        if (_isLoading) return;

        try
        {
            _isLoading = true;
            await _form.Validate();

            if (!_form.IsValid) return;

            if(string.IsNullOrEmpty(_model.InstallationGuide))
            {
                _snackbar.Add("Vui lòng nhập quy trình cài đặt", MudBlazor.Severity.Warning);
                return;
            }

            _model.VersionName = _model.VersionName.Trim();
            _model.Links = _uploadFileResponse.LinkDownload;
            _model.FileSize = _uploadFileResponse.Size ?? 0;
            _model.Status = Constant.StatusDefault.Active;
            if (!string.IsNullOrEmpty(_model.InstallationGuide)) _model.InstallationGuide = _model.InstallationGuide.Trim();
            if (!string.IsNullOrEmpty(_model.Note)) _model.Note = _model.Note.Trim();
            if (!string.IsNullOrEmpty(_model.Changelog)) _model.Changelog = _model.Changelog.Trim();

            var res = await _adminPatchVersionService.CreatePatchVersion(_model, _token);

            if (res.IsSuccess)
            {
                _snackbar.Add("Tạo thành công", MudBlazor.Severity.Success);
                navigation.NavigateTo(RouterConfig.Admin.Version);
            }
            else
            {
                _snackbar.Add("Tạo thất bại", MudBlazor.Severity.Error);
            }
        }
        catch (Exception)
        {
            _isLoading = false;
        }
        finally
        {
            _isLoading = false;
        }
    }
}

<style>
    .reset-css,
    .reset-css * {
        all: unset;
        all: revert;
        box-sizing: border-box;
    }
</style>