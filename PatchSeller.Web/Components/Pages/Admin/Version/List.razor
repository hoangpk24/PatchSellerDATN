@page "/admin/version"
@layout AdminLayout

<PageTitle>@Constant.PageTitleAdmin Patch Version</PageTitle>

<section class="p-6">
    <div class="flex items-center justify-between">
        <h1 class="leading-[3rem] h-12 text-3xl font-bold text-material-default">Danh sách phiên bản</h1>
        <a href="@RouterConfig.Admin.CreateVersion" class="leading-[1.5rem] h-10 rounded bg-material-default px-6 py-2 text-white shadow-md">Tạo mới</a>
    </div>

    <div class="mt-8 rounded bg-white shadow-md">
        <MudTable Items="@_lstPatchVersion" Elevation="0" Loading="@_isLoading" Hover="true" Virtualize="true" FixedHeader="true" HorizontalScrollbar="true" Height="calc(100lvh - 233px)">
            <HeaderContent>
                <MudTh Class="whitespace-nowrap" hidden><MudTableSortLabel SortLabel="Id" T="string" hidden>STT</MudTableSortLabel></MudTh>
                <MudTh Class="!whitespace-nowrap"><MudTableSortLabel SortLabel="Tên" T="string">Thuộc game</MudTableSortLabel></MudTh>
                <MudTh Class="!whitespace-nowrap"><MudTableSortLabel SortLabel="Tên" T="string">Thuộc gói</MudTableSortLabel></MudTh>
                <MudTh Class="!whitespace-nowrap"><MudTableSortLabel SortLabel="Số điện thoại" T="string">Phiên bản</MudTableSortLabel></MudTh>
                <MudTh Class="!whitespace-nowrap"><MudTableSortLabel SortLabel="Số điện thoại" T="string">Ghi chú</MudTableSortLabel></MudTh>
                <MudTh Class="!whitespace-nowrap"><MudTableSortLabel SortLabel="Số điện thoại" T="string">Người cập nhật</MudTableSortLabel></MudTh>
                <MudTh Class="!whitespace-nowrap"><MudTableSortLabel SortLabel="Thao tác" T="string">Thao tác</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Id" hidden>@context.PatchVersionId</MudTd>
                <MudTd DataLabel="Email">@context.GameName</MudTd>
                <MudTd DataLabel="Tên">@context.PatchName</MudTd>
                <MudTd DataLabel="Số điện thoại">@context.VersionName</MudTd>
                <MudTd DataLabel="Số điện thoại">@context.Note</MudTd>
                <MudTd DataLabel="Số điện thoại">@context.StaffName</MudTd>
                <MudTd DataLabel="Thao tác">
                    <div class="flex flex-nowrap items-center gap-2">
                        <MudIconButton Icon="@Icons.Material.Filled.BorderColor" aria-label="update" OnClick="@(() => navigation.NavigateTo(RouterConfig.Admin.EditVersion.Replace(":id", context.PatchVersionId.ToString())))"></MudIconButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="delete" OnClick="@(() => OpenDialogDelete(context.PatchVersionId))"></MudIconButton>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="my-4">Không có dữ liệu.</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <div class="flex w-full flex-col gap-3">
                    @{
                        for (var i = 0; i < 5; i++)
                        {
                            <div class="flex items-center justify-between gap-2 px-2">
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                            </div>
                        }
                    }
                </div>
            </LoadingContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </div>
</section>

@code {
    List<PatchVersionDetailResponse> _lstPatchVersion = [];

    private string _searchValue = string.Empty;
    private bool _isLoading = true;

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadData();
        }
        catch (Exception)
        {
            _isLoading = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    async Task LoadData()
    {
        var res = await _adminPatchVersionService.GetAll();
        var data = res.Data;
        if (res.IsSuccess && data != null)
        {
            _lstPatchVersion = data;
        }
        else if (res.IsSuccess == false && res.StatusCode == "NotFound")
        {
            _snackbar.Add("Không tìm thấy trang này.", MudBlazor.Severity.Error);
            navigation.NavigateTo(RouterConfig.NotFound);
        }
        else
        {
            _snackbar.Add("Đã có lỗi xảy ra. Vui lòng báo cho quản trị viên.", MudBlazor.Severity.Error);
            navigation.NavigateTo(RouterConfig.Admin.Category);
        }
        StateHasChanged();
    }

    async Task OpenDialogDelete(int id)
    {
        var deleteParaeters = new DialogParameters<Admin.Version.ConfirmDeleteDialog>
        {
            {x => x.id, id}
        };

        var dialog = await _dialogService.ShowAsync<Admin.Version.ConfirmDeleteDialog>("Options Dialog", deleteParaeters, _dialogOptions);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData();
            StateHasChanged();
        }
    }
}