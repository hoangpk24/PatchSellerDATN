@page "/admin/version/{id:int}/edit"
@layout AdminLayout

<PageTitle>@Constant.PageTitleAdmin Patch Version Edit</PageTitle>

@if (_isLoadingUpload)
{
    <div class="absolute bottom-0 left-0 right-0 top-0 z-20 bg-black/50">
        <Loading />
    </div>
}

<section class="mx-auto max-w-[1280px] p-6">
    <h1 class="leading-[3rem] text-3xl font-bold text-material-default">Sửa phiên bản</h1>

    <div class="rounded bg-white p-10 shadow-md">
        <MudForm Model="_model" @ref="_form" Validation="_schema.ValidateValue">
            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Phiên bản</label> <span class="ml-1 text-red-500">*</span>

                <MudTextField T="string"
                              @bind-Value="_model.VersionName"
                              For="@(() => _model.VersionName)"
                              Variant="Variant.Outlined"
                              Placeholder="Ví dụ: v1.1..."
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Tóm tắt phiên bản</label> <span class="ml-1 text-red-500">*</span>

                <MudTextField T="string"
                              Lines="5"
                              @bind-Value="_model.Changelog"
                              For="@(() => _model.Changelog)"
                              Variant="Variant.Outlined"
                              Placeholder="Nhập tóm tắt ngắn gọn về phiên bản này..."
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Mật khẩu giải nén</label>

                <MudTextField T="string"
                              @bind-Value="_model.ExtractionPassword"
                              For="@(() => _model.ExtractionPassword)"
                              Variant="Variant.Outlined"
                              Placeholder="Nhập mật khẩu nếu có..."
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Quy trình cài đặt</label>

                <RichTextEditor @bind-Content="@_model.InstallationGuide"
                                Placeholder="Quy trình các bước cài đặt..."
                                ToolbarOptions="@ToolbarOptions.FullToolbarOptions"
                                Theme="@QuillTheme.Snow" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Thuộc gói</label> <span class="ml-1 text-red-500">*</span>

                <MudSelect T="int" @bind-Value="_model.PatchId" For="@(() => _model.PatchId)" Variant="Variant.Outlined" Placeholder="Riot Games" Margin="Margin.Dense" Disabled>
                    <MudSelectItem Value="0">- Vui lòng chọn -</MudSelectItem>
                    @if (_lstPatch.Any())
                    {
                        @foreach (var item in _lstPatch)
                        {
                            <MudSelectItem Value="@item.PatchId">@item.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Nhân viên sửa</label> <span class="ml-1 text-red-500">*</span>

                <MudSelect T="int" @bind-Value="_model.StaffId" For="@(() => _model.StaffId)" Variant="Variant.Outlined" Placeholder="Riot Games" Margin="Margin.Dense">
                    <MudSelectItem Value="0">- Vui lòng chọn -</MudSelectItem>
                    @if (_lstStaff.Any())
                    {
                        @foreach (var item in _lstStaff)
                        {
                            <MudSelectItem Value="@item.StaffId">@item.FullName</MudSelectItem>
                        }
                    }
                </MudSelect>
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Tải lên file</label>

                <MudFileUpload T="IBrowserFile" FilesChanged="@(async (file) => await UploadFile(file))">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(_uploadFileResponse != null || _isLoadingUpload || _isLoading)"
                                   StartIcon="@Icons.Material.Filled.CloudUpload">
                            Upload Files
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>

                @if (_uploadFileResponse != null)
                {
                    <div class="mt-4 flex items-center gap-4 rounded border border-slate-200 bg-slate-50 p-4">
                        <div class="flex-1">
                            <div class="font-bold text-slate-700">@_fileName</div>
                            <div class="text-sm text-slate-500">Kích thước: @_uploadFileResponse.SizeMb mb</div>
                        </div>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Disabled="@(_isLoading || _isLoadingUpload)"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="RemoveFileAsync">
                            Xóa file
                        </MudButton>
                    </div>
                }
                <div>
                </div>
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Ghi chú</label>

                <MudTextField T="string"
                              Lines="5"
                              @bind-Value="_model.Note"
                              For="@(() => _model.Note)"
                              Variant="Variant.Outlined"
                              Placeholder="Nhập ghi chú..."
                              Margin="Margin.Dense" />
            </div>

            <MudDivider Class="mb-8 mt-4 !border-slate-200" />

            <div class="flex items-center justify-end gap-3">
                <MudButton Variant="Variant.Text"
                           Class="px-6 py-2 text-slate-500 hover:bg-slate-200"
                           OnClick="() => navigation.NavigateTo(RouterConfig.Admin.Version)">
                    Quay lại
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="@(async () => await OnSubmit())"
                           Disabled="@(_isLoading || _isLoadingUpload)"
                           Class="px-8 py-2.5 font-bold shadow-lg shadow-material-default/20">
                    Sửa
                </MudButton>
            </div>
        </MudForm>
    </div>
</section>

@code {
    [Parameter]
    public int id { get; set; }

    [CascadingParameter(Name = Constant.CascadingNameParams.Mine)]
    public MineResponse _mine { get; set; }

    [CascadingParameter(Name = Constant.CascadingNameParams.Token)]
    public string _token { get; set; }

    MudForm _form = new MudForm();
    List<DAL.Models.Patch> _lstPatch = [];
    List<DAL.Models.Staff> _lstStaff = [];
    UploadFileResponse _uploadFileResponse = null;
    CheckFileResponse _checkFileResponse = null;
    PatchVersionModel _model = new PatchVersionModel();
    PatchVersionSchema.CreateUpdate _schema = new PatchVersionSchema.CreateUpdate();

    string _fileName = string.Empty;
    bool _isLoadingUpload = false;
    string _oldFileLink = string.Empty;
    bool _isLoading = false;
    string _content = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            await LoadData();
        }
        catch (Exception)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    async Task LoadData()
    {
        var response = await _adminPatchService.GetAll();
        if (response.IsSuccess)
        {
            _lstPatch = response.Data;
        }

        var responseStaff = await _adminStaffService.GetAll();
        if (responseStaff.IsSuccess)
        {
            _lstStaff = responseStaff.Data;
        }


        var resPatchVersion = await _adminPatchVersionService.GetById(id);

        if(resPatchVersion.IsSuccess)
        {
            var data = resPatchVersion.Data;
            _model = new PatchVersionModel
            {
                PatchVersionId = data.PatchVersionId,
                PatchId = data.PatchId,
                Changelog = data.Changelog,
                ExtractionPassword = data.ExtractionPassword,
                InstallationGuide = data.InstallationGuide,
                StaffId = data.StaffId,
                Status = data.Status,
                FileSize = data.FileSize,
                Links = data.Links,
                Note =data.Note,
                VersionName = data.VersionName,
                WorkWithGameVersion = data.WorkWithGameVersion,
            };

            if (!string.IsNullOrEmpty(data.Links))
            {
                _oldFileLink = data.Links;

                var checkFile = await _adminUploadService.CheckFile(data.Links);
                if (checkFile.IsSuccess)
                {
                    _uploadFileResponse = new UploadFileResponse
                    {
                        Link = data.Links,
                        SizeMb = checkFile.Data.SizeMb,
                    };
                    _fileName = checkFile.Data.Name;
                }
            }
        }
        else if (resPatchVersion.IsSuccess == false && resPatchVersion.StatusCode == "NotFound")
        {
            _snackbar.Add("Không tìm thấy này.", MudBlazor.Severity.Error);
            navigation.NavigateTo(RouterConfig.NotFound);
        }
        else
        {
            _snackbar.Add("Đã có lỗi xảy ra. Vui lòng báo cho quản trị.", MudBlazor.Severity.Error);
            navigation.NavigateTo(RouterConfig.Admin.Patch);
        }
    }

    private async Task UploadFile(IBrowserFile file)
    {
        if (file == null) return;

        try
        {
            _isLoadingUpload = true;

            using var stream = file.OpenReadStream(maxAllowedSize: 10L * 1024 * 1024 * 1024);
            var res = await _adminUploadService.UploadFileAsync(stream, file.Name);

            if (res.IsSuccess)
            {
                _uploadFileResponse = res.Data;
                _fileName = file.Name;
                _snackbar.Add("Đã tải file mới lên thành công!", MudBlazor.Severity.Info);
            }
        }
        catch (Exception ex) { /* handle ex */ }
        finally
        {
            _isLoadingUpload = false;
            StateHasChanged();
        }
    }

    private async Task RemoveFileAsync()
    {
        if (_uploadFileResponse == null) return;

        try
        {
            _isLoadingUpload = true;

            if (_uploadFileResponse.Link == _oldFileLink)
            {
                _snackbar.Add("Xóa file thành công!", MudBlazor.Severity.Success);
                _uploadFileResponse = null;
                return;
            }

            var res = await _adminUploadService.DeleteFileAsync(_uploadFileResponse.Link);

            if (res.IsSuccess)
            {
                _snackbar.Add("Xóa file thành công!", MudBlazor.Severity.Success);
            }
            else
            {
                _snackbar.Add($"Lỗi xóa file: {res.ErrorMessage}", MudBlazor.Severity.Error);
            }
        }
        catch (Exception)
        {
        }
        finally
        {
            _isLoadingUpload = false;
            _uploadFileResponse = null;
            _fileName = string.Empty;
            _model.Links = string.Empty;
            _model.FileSize = 0;
            StateHasChanged();
        }
    }

    async Task OnSubmit()
    {
        if (_isLoading) return;


        if (_uploadFileResponse == null)
        {
            _snackbar.Add("Vui lòng tải lên file trước khi sửa phiên bản", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _isLoading = true;
            await _form.Validate();

            if (!_form.IsValid) return;

            if (string.IsNullOrEmpty(_model.InstallationGuide))
            {
                _snackbar.Add("Vui lòng nhập quy trình cài đặt", MudBlazor.Severity.Warning);
                return;
            }

            if (_uploadFileResponse.LinkDownload != _oldFileLink)
            {
                if (!string.IsNullOrEmpty(_oldFileLink))
                {
                    var resDelete = await _adminUploadService.DeleteFileAsync(_oldFileLink);
                }
            }

            _model.VersionName = _model.VersionName.Trim();
            if (_oldFileLink != _uploadFileResponse.LinkDownload)
            {
                _model.Links = _uploadFileResponse.LinkDownload;
                _model.FileSize = _uploadFileResponse?.Size ?? 0;
            }
            if (!string.IsNullOrEmpty(_model.InstallationGuide)) _model.InstallationGuide = _model.InstallationGuide.Trim();
            if (!string.IsNullOrEmpty(_model.Note)) _model.Note = _model.Note.Trim();
            if (!string.IsNullOrEmpty(_model.Changelog)) _model.Changelog = _model.Changelog.Trim();

            var res = await _adminPatchVersionService.UpdatePatchVersion(_model, _token);

            if (res.IsSuccess)
            {
                _snackbar.Add("Sửa thành công", MudBlazor.Severity.Success);
                navigation.NavigateTo(RouterConfig.Admin.Version);
            }
            else
            {
                _snackbar.Add("Sửa thất bại", MudBlazor.Severity.Error);
            }
        }
        catch (Exception)
        {
            _isLoading = false;
        }
        finally
        {
            _isLoading = false;
        }
    }
}

<style>
    .reset-css,
    .reset-css * {
        all: unset;
        all: revert;
        box-sizing: border-box;
    }
</style>

