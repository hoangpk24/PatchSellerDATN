@page "/admin/voucher"
@layout AdminLayout

<PageTitle>@Constant.PageTitleAdmin Platform</PageTitle>

<section class="p-6">
    <div class="flex items-center justify-between">
        <h1 class="leading-[3rem] text-material-default h-12 text-3xl font-bold">Danh sách mã giảm giá</h1>
        <AuthorizeControl Action="@Constant.ActionButton.Create">
            <a href="@RouterConfig.Admin.CreateVoucher" class="leading-[1.5rem] bg-material-default h-10 rounded px-6 py-2 text-white shadow-md">Tạo mới</a>
        </AuthorizeControl>
    </div>

    <div class="mt-8 rounded bg-white p-6 shadow-md">
        <div class="grid w-full grid-cols-3 items-start gap-x-6 gap-y-4">
            <div>
                <MudTextField T="string" Placeholder="Tìm kiếm" Adornment="Adornment.Start" Value="@_searchValue"
                              AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" IconSize="Size.Medium" Class="mt-0" Margin="Margin.Dense" ValueChanged="onChangeSearch" Immediate=true></MudTextField>
            </div>
            <div>
                <MudSelect class="mt-0" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="@_searchDiscountType">
                    <MudSelectItem Value="@("")">Tất cả</MudSelectItem>
                    <MudSelectItem Value="@(Constant.DiscountTypePercent)">Phần trăm</MudSelectItem>
                    <MudSelectItem Value="@(Constant.DiscountTypeFixed)">Giá Cố định</MudSelectItem>
                </MudSelect>
            </div>
            <div>
                <MudSelect class="mt-0" T="int" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="@_searchRank">
                    <MudSelectItem Value="0">Tất cả</MudSelectItem>
                    <MudSelectItem Value="1">Đồng</MudSelectItem>
                    <MudSelectItem Value="2">Bạc</MudSelectItem>
                    <MudSelectItem Value="3">Vàng</MudSelectItem>
                </MudSelect>
            </div>
            <div>
                <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Placeholder="Ngày bắt đầu" Date="@_startDate" DateChanged="OnChangeStartDate" MaxDate="@_maxStartDate" />
            </div>
            <div>
                <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Placeholder="Ngày kết thúc" Date="@_endDate" DateChanged="OnChangeEndDate" MinDate="@_minEndDate" />
            </div>
            <div class="flex items-center gap-2">
                <MudButton Variant="Variant.Outlined" OnClick="OnSearch" Class="h-10 w-full"><MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" /> Tìm kiếm</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="OnReset" Class="h-10 w-full"><MudIcon Icon="@Icons.Material.Filled.Filter" Class="mr-2" /> Đặt lại</MudButton>
            </div>
        </div>
    </div>

    <div class="mt-8 rounded bg-white shadow-md">
        <MudTable Items="@_lstDiscount" Elevation="0" Loading="@_isLoading" Hover="true" Virtualize="true" FixedHeader="true" HorizontalScrollbar="true" Height="calc(100lvh - 413px)">
            <HeaderContent>
                <MudTh hidden><MudTableSortLabel SortLabel="Id" T="string" hidden>STT</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Mã" T="string">Mã</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Loại" T="string">Loại</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Cấp bậc được áp dụng" T="string">Cấp bậc được áp dụng</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Số điện thoại" T="string">Giá trị</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Mã đăng nhập" T="string">Giá áp dụng tối thiểu</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Chức vụ" T="string">Giá giảm tối đa</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Chức vụ" T="string">Số lượt được sử dụng</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Chức vụ" T="string">Số mã được phát hành</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="StartDate" T="string">Ngày bắt đầu</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="EndDate" T="string">Ngày kết thúc</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="EndDate" T="string">Trạng thái</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Thao tác" T="string">Thao tác</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Id" hidden>@context.DiscountId</MudTd>
                <MudTd DataLabel="Mã">@context.Code</MudTd>
                <MudTd Class="!whitespace-nowrap" DataLabel="Loại">@(context.DiscountType == Constant.DiscountTypePercent ? "Phần trăm (%)" : "Giá cố định (đ)")</MudTd>
                <MudTd Class="!whitespace-nowrap" DataLabel="Cấp bậc được áp dụng">
                    @{
                        if(context.RankId == null)
                        {
                            <span>Tất cả</span>
                        } else
                        {
                            if(_lstRank != null && _lstRank.Any())
                            {   
                                var obj = _lstRank.FirstOrDefault(x => x.RankId == context.RankId);

                                <span>@(obj != null ? obj.RankName : "")</span>
                            }
                        }
                    }
                </MudTd>
                <MudTd DataLabel="Số điện thoại">@(FormatDiscountValue(context))</MudTd>
                <MudTd DataLabel="Tên đăng nhập">@(context.MinOrderValue?.ToString("C0", vietnameseCulture) ?? "Không có")</MudTd>
                <MudTd DataLabel="Số điện thoại">@(context.MaxDiscount?.ToString("C0", vietnameseCulture) ?? "Không có")</MudTd>
                <MudTd DataLabel="Số điện thoại">@context.LimitPerUser</MudTd>
                <MudTd DataLabel="Số điện thoại">@context.UsageLimit</MudTd>
                <MudTd class="!whitespace-nowrap" DataLabel="EndDate">@context.StartDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd class="!whitespace-nowrap" DataLabel="EndDate">@context.EndDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Trạng thái">
                    @if (context.StartDate > DateTime.Now)
                    {
                        <span class="whitespace-nowrap font-medium uppercase">Chưa phát hành</span>
                    } else
                    {
                        @if (context.StartDate <= DateTime.Now && context.EndDate >= DateTime.Now)
                        {
                            <span class="whitespace-nowrap font-medium uppercase text-green-500">Đang diễn ra</span>
                        } else
                        {
                            <span class="whitespace-nowrap font-medium uppercase text-red-500">Đã hết hạn</span>
                        }
                    }
                </MudTd>
                <MudTd DataLabel="Thao tác" Class="!flex !flex-nowrap">
                    @{
                        bool isActiveNow = IsCouponActiveNow(context);
                    }
                    <AuthorizeControl Action="@Constant.ActionButton.Edit">
                        <MudIconButton Color="Color.Warning" Disabled="@isActiveNow" Icon="@Icons.Material.Filled.BorderColor" aria-label="update" OnClick="@(() => navigation.NavigateTo(RouterConfig.Admin.EditVoucher.Replace(":id", context.DiscountId.ToString())))"></MudIconButton>
                    </AuthorizeControl>
                    <AuthorizeControl Action="@Constant.ActionButton.Delete">
                        <MudIconButton Color="Color.Error" Disabled="@isActiveNow" Icon="@Icons.Material.Filled.Delete" aria-label="delete" OnClick="@(() => OpenDialogDelete(context.DiscountId))"></MudIconButton>
                    </AuthorizeControl>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="my-4">Không có dữ liệu.</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <div class="flex w-full flex-col gap-3">
                    @{
                        for (var i = 0; i < 5; i++)
                        {
                            <div class="flex items-center justify-between gap-2 px-2">
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                            </div>
                        }
                    }
                </div>
            </LoadingContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </div>
</section>

@code {
    List<DAL.Models.Discount> _lstDiscount = [];
    List<DAL.Models.Rank> _lstRank = [];

    private string _searchValue = string.Empty;
    private string _searchDiscountType = string.Empty;
    private int _searchRank = 0;
    private DateTime? _startDate = DateTime.Now.AddMonths(-6);
    private DateTime? _endDate = DateTime.Now.AddMonths(6);
    private DateTime? _maxStartDate = DateTime.Now.AddMonths(6);
    private DateTime? _minEndDate = DateTime.Now.AddMonths(-6);
    private bool _isLoading = true;

    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    private void onChangeSearch(string value)
    {
        _searchValue = value.Trim();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadData();
        }
        catch (Exception)
        {
            _isLoading = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    async Task LoadData()
    {
        var res = await _adminDiscountService.GetAll(_searchValue, _searchDiscountType, _searchRank);
        var data = res.Data;
        if (res.IsSuccess && data != null)
        {
            _lstDiscount = data;
        }
        else if (res.IsSuccess == false && res.StatusCode == "NotFound")
        {
            _snackbar.Add("Không tìm thấy trang này.", MudBlazor.Severity.Error);
            navigation.NavigateTo(RouterConfig.NotFound);
        }
        else
        {
            _snackbar.Add("Đã có lỗi xảy ra. Vui lòng báo cho quản trị viên.", MudBlazor.Severity.Error);
            navigation.NavigateTo(RouterConfig.Admin.Category);
        }

        var resRank = await _adminRankService.GetAll();
        if (resRank.IsSuccess)
        {
            _lstRank = resRank.Data;
        }
        StateHasChanged();
    }

    private async Task OnSearch()
    {
        await LoadData();
    }

    private void OnChangeStartDate(DateTime? value)
    {
        _startDate = value;
        _minEndDate = value;
    }

    private void OnChangeEndDate(DateTime? value)
    {
        _endDate = value;
        _maxStartDate = value;
    }

    private async Task OnReset()
    {
        _searchValue = string.Empty;
        _searchDiscountType = string.Empty;
        _searchRank = 0;
        _startDate = DateTime.Now.AddMonths(-6);
        _endDate = DateTime.Now;
        _maxStartDate = DateTime.Now;
        _minEndDate = DateTime.Now.AddMonths(-6);
        await LoadData();
    }

    private bool IsCouponActiveNow(DAL.Models.Discount discount)
    {
        var now = DateTime.Now;

        return discount.Delete != true && (now >= discount.StartDate);
    }

    private string FormatDiscountValue(DAL.Models.Discount discount)
    {
        if (discount.DiscountType == Constant.DiscountTypePercent)
        {
            return $"{discount.Value.ToString("F0")}%";
        }
        else if (discount.DiscountType == Constant.DiscountTypeFixed)
        {
            return $"{discount.Value.ToString("C0", vietnameseCulture)}";
        }
        return discount.Value.ToString();
    }

    async Task OpenDialogDelete(int id)
    {
        var deleteParaeters = new DialogParameters<Admin.Voucher.ConfirmDeleteDialog>
        {
            {x => x.id, id}
        };

        var dialog = await _dialogService.ShowAsync<Admin.Voucher.ConfirmDeleteDialog>("Options Dialog", deleteParaeters, _dialogOptions);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData();
            StateHasChanged();
        }
    }
}

<style>
    .mud-picker > .mud-input-control {
        margin: 0 !important;
    }
</style>