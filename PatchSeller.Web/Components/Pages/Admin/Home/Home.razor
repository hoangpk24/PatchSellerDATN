@page "/admin/home"
@layout AdminLayout

<PageTitle>@Constant.PageTitleAdmin Home</PageTitle>

<section class="p-6">
    <div class="rounded-lg border border-slate-200 bg-white p-8 shadow-sm">
        <div class="text-center">
            <h2 class="mb-4 text-2xl font-semibold text-material-default">Chào mừng đến với trang quản trị của ITEAM@(_mine != null && _mine.FullName != null ? ", " + _mine.FullName + "!" : "")</h2>

            <p class="mb-6 text-lg text-gray-600">
                Đây là màn hình quản lý hệ thống quản lý cửa hàng bán gói game việt hóa. Có nhiều chức năng quản lý khác nhau.
            </p>

            <p class="text-sm text-gray-500">Bạn có thể truy cập nhiều chức năng quản lý khác nhau từ menu bên trái.</p>
        </div>
    </div>
</section>

@code {
    [CascadingParameter(Name = Constant.CascadingNameParams.Mine)]
    public StaffGetMe _mine { get; set; }
}