@page "/admin/category/{id:int}/edit"
@layout AdminLayout

<PageTitle>@Constant.PageTitleAdmin Category Edit</PageTitle>

<section class="p-6">
    <MudBreadcrumbs Class="!p-0 !text-sm" Items="_itemBreadcrumbs" Separator=">"></MudBreadcrumbs>

    <h1 class="leading-[3rem] text-3xl font-bold text-material-default">Sửa thể loại</h1>
</section>

@code {
    [Parameter]
    public int id { get; set; }

    private List<BreadcrumbItem> _itemBreadcrumbs =
    [
        new("Trang Chủ", href: RouterConfig.Admin.Home),
        new("Thể Loại", href: RouterConfig.Admin.Category),
        new("Tạo Thể Loại", href: "#", disabled: true),
    ];
}
