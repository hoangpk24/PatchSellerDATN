@page "/admin/customer"
@layout AdminLayout

<PageTitle>@Constant.PageTitleAdmin Customer</PageTitle>

<section class="p-6">
    <div class="flex items-center justify-between">
        <h1 class="leading-[3rem] text-material-default h-12 text-3xl font-bold">Danh sách khách hàng</h1>
        
        <AuthorizeControl Action="@Constant.ActionButton.Create">
            <a href="@RouterConfig.Admin.CreateCustomer" class="leading-[1.5rem] bg-material-default h-10 rounded px-6 py-2 text-white shadow-md">Tạo mới</a>
        </AuthorizeControl>
    </div>

    <div class="mt-8 rounded bg-white p-6 shadow-md">
        <div class="grid w-full grid-cols-3 items-start gap-x-6 gap-y-4">
            <div>
                <MudTextField T="string" Placeholder="Tìm kiếm" Adornment="Adornment.Start" Value="@_searchValue"
                              AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" IconSize="Size.Medium" Class="mt-0" Margin="Margin.Dense" ValueChanged="onChangeSearch" Immediate=true></MudTextField>
            </div>
            <div>
                <MudSelect T="int" Label="Cấp bậc" class="mt-0" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="@_searchRank">
                    <MudSelectItem Value="0">Tất cả</MudSelectItem>
                    <MudSelectItem Value="1">Đồng</MudSelectItem>
                    <MudSelectItem Value="2">Bạc</MudSelectItem>
                    <MudSelectItem Value="3">Vàng</MudSelectItem>
                </MudSelect>
            </div>
            <div class="flex items-center gap-2">
                <MudButton Variant="Variant.Outlined" OnClick="OnSearch" Class="h-10 w-full"><MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" /> Tìm kiếm</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="OnReset" Class="h-10 w-full"><MudIcon Icon="@Icons.Material.Filled.Filter" Class="mr-2" /> Đặt lại</MudButton>
            </div>
        </div>
    </div>

    <div class="mt-8 rounded bg-white shadow-md">
        <MudTable Items="@_lstUser" Elevation="0" Loading="@_isLoading" Hover="true" Virtualize="true" FixedHeader="true" HorizontalScrollbar="true" Height="calc(100lvh - 357px)">
            <HeaderContent>
                <MudTh hidden><MudTableSortLabel SortLabel="Id" T="string" hidden>STT</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Tên" T="string">Tên</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Email" T="string">Email</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Số điện thoại" T="string">Số điện thoại</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Tên đăng nhập" T="string">Tên đăng nhập</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Cấp bậc" T="string">Cấp bậc</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Thao tác" T="string">Thao tác</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Id" hidden>@context.UserId</MudTd>
                <MudTd DataLabel="Tên">@context.FullName</MudTd>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel="Số điện thoại">@context.PhoneNumber</MudTd>
                <MudTd DataLabel="Tên đăng nhập">@context.UserName</MudTd>
                <MudTd DataLabel="Cấp bậc">
                    @{
                        if(_lstRank != null && _lstRank.Any())
                        {
                            var obj = _lstRank.FirstOrDefault(x => x.RankId == context.RankId);

                            <span>@(obj != null ? obj.RankName : "")</span>
                        }
                    }
                </MudTd>
                <MudTd DataLabel="Thao tác">
                    <AuthorizeControl Action="@Constant.ActionButton.Edit">
                        <MudIconButton Color="Color.Warning" Icon="@Icons.Material.Filled.BorderColor" aria-label="update" OnClick="@(() => navigation.NavigateTo(RouterConfig.Admin.EditCustomer.Replace(":id", context.UserId.ToString())))"></MudIconButton>
                    </AuthorizeControl>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="my-4">Không có dữ liệu.</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <div class="flex w-full flex-col gap-3">
                    @{
                        for (var i = 0; i < 5; i++)
                        {
                            <div class="flex items-center justify-between gap-2 px-2">
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                                <MudSkeleton Width="100%" Height="5rem" />
                            </div>
                        }
                    }
                </div>
            </LoadingContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </div>
</section>

@code {
    List<DAL.Models.User> _lstUser = [];
    List<DAL.Models.Rank> _lstRank = [];

    private string _searchValue = string.Empty;
    private int _searchRank = 0;
    private bool _isLoading = true;

    private List<BreadcrumbItem> _itemBreadcrumbs =
    [
        new("Trang Chủ", href: RouterConfig.Admin.Home),
        new("Khách Hàng", href: "#", disabled: true),
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadData();
        }
        catch (Exception)
        {
            _isLoading = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    async Task LoadData()
    {
        var res = await _adminUserService.GetAll(_searchValue, _searchRank);
        var data = res.Data;
        if (res.IsSuccess && data != null)
        {
            _lstUser = data;
        }
        else if (res.IsSuccess == false && res.StatusCode == "NotFound")
        {
            _snackbar.Add("Không tìm thấy trang này.", MudBlazor.Severity.Error);
            navigation.NavigateTo(RouterConfig.NotFound);
        }
        else
        {
            _snackbar.Add("Đã có lỗi xảy ra. Vui lòng báo cho quản trị viên.", MudBlazor.Severity.Error);
            navigation.NavigateTo(RouterConfig.Admin.Category);
        }

        var resRank = await _adminRankService.GetAll();
        if (resRank.IsSuccess)
        {
            _lstRank = resRank.Data;
        }
        StateHasChanged();
    }

    private void onChangeSearch(string value)
    {
        _searchValue = value.Trim();
    }

    private async Task OnSearch()
    {
        await LoadData();
    }

    private async Task OnReset()
    {
        _searchValue = string.Empty;
        _searchRank = 0;
        await LoadData();
    }
}