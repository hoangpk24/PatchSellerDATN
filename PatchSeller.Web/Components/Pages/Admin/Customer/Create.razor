@page "/admin/customer/create"
@layout AdminLayout

<PageTitle>@Constant.PageTitleAdmin Customer Create</PageTitle>

<section class="mx-auto max-w-[1280px] p-6">
    <h1 class="leading-[3rem] mb-4 h-12 text-3xl font-bold text-material-default">Tạo khách hàng mới</h1>

    <div class="rounded bg-white p-10 shadow-md">
        <MudForm @ref="_form" Model="_model" Validation="_staffSchema.ValidateValue">

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Họ và tên</label> <span class="ml-1 text-red-500">*</span>
                <MudTextField T="string"
                              @bind-Value="_model.FullName"
                              For="@(() => _model.FullName)"
                              Variant="Variant.Outlined"
                              Placeholder="Ví dụ: Nguyễn văn a"
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Email</label> <span class="ml-1 text-red-500">*</span>
                <MudTextField T="string"
                              @bind-Value="_model.Email"
                              For="@(() => _model.Email)"
                              Variant="Variant.Outlined"
                              Placeholder="Ví dụ: nva@gmail.com"
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Số điện thoại</label>
                <MudTextField T="string"
                              @bind-Value="_model.PhoneNumber"
                              For="@(() => _model.PhoneNumber)"
                              Variant="Variant.Outlined"
                              Placeholder="Ví dụ: 0912345678"
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Tên đăng nhập</label> <span class="ml-1 text-red-500">*</span>
                <MudTextField T="string"
                              @bind-Value="_model.UserName"
                              For="@(() => _model.UserName)"
                              Placeholder="Ví dụ: anguyen..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Mật khẩu</label> <span class="ml-1 text-red-500">*</span>
                <MudTextField T="string"
                              @bind-Value="_model.PasswordHash"
                              For="@(() => _model.PasswordHash)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Placeholder="********"
                              InputType="@(_passwordVisibility ? InputType.Text : InputType.Password)"
                              Class="custom-text-field"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_passwordVisibility ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="TogglePasswordVisibility"
                              AdornmentAriaLabel="Show Password" />
            </div>

            <MudDivider Class="mb-8 mt-4 !border-slate-200" />

            <div class="flex items-center justify-end gap-3">
                <MudButton Variant="Variant.Text"
                           Class="px-6 py-2 text-slate-500 hover:bg-slate-200"
                           OnClick="() => navigation.NavigateTo(RouterConfig.Admin.Customer)">
                    Quay lại
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(async () => await OnSubmit())"
                           Disabled="@_isLoading"
                           Class="px-8 py-2.5 font-bold shadow-lg shadow-material-default/20">
                    Tạo mới
                </MudButton>
            </div>
        </MudForm>
    </div>
</section>

@code {
    MudForm _form = new MudForm();
    DAL.Models.User _model = new DAL.Models.User();
    UserSchema.CreateUpdate _staffSchema = new UserSchema.CreateUpdate();

    private bool _isLoading = false;
    private bool _passwordVisibility = false;

    private void TogglePasswordVisibility() => _passwordVisibility = !_passwordVisibility;

    private List<BreadcrumbItem> _itemBreadcrumbs =
    [
        new("Trang Chủ", href: RouterConfig.Admin.Home),
        new("Khách Hàng", href: RouterConfig.Admin.Customer),
        new("Tạo Khách Hàng", href: "#", disabled: true),
    ];

    async Task OnSubmit()
    {
        if (_isLoading) return;

        try
        {
            _isLoading = true;
            await _form.Validate();

            if (!_form.IsValid) return;

            _model.FullName = _model.FullName.Trim();
            _model.UserName = _model.UserName.Trim();
            _model.Email = _model.Email.Trim();
            _model.PasswordHash = _model.PasswordHash.Trim();
            _model.PhoneNumber = _model.PhoneNumber.Trim();
            _model.Status = 1;
            _model.RankId = 1;
            _model.RewardPoint = 0;

            var response = await _adminUserService.CreateUser(_model);

            if (response.IsSuccess)
            {
                _snackbar.Add("Tạo thành công!", MudBlazor.Severity.Success);
                navigation.NavigateTo(RouterConfig.Admin.Customer);
            }
            else
            {
                var mess = string.IsNullOrEmpty(response.ErrorMessage) ? "Tạo thất bại" : response.ErrorMessage;
                _snackbar.Add(mess, MudBlazor.Severity.Error);
            }
        }
        catch (Exception)
        {
            _isLoading = false;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
