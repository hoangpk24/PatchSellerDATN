@page "/admin/customer/{id:int}/edit"
@layout AdminLayout

<PageTitle>@Constant.PageTitleAdmin Customer Edit</PageTitle>

<section class="p-6">
    <MudBreadcrumbs Class="!p-0 !text-sm" Items="_itemBreadcrumbs" Separator=">"></MudBreadcrumbs>

    <h1 class="leading-[3rem] text-3xl font-bold text-material-default">Sửa khách hàng</h1>
</section>

@code {
    [Parameter]
    public int id { get; set; }

    private List<BreadcrumbItem> _itemBreadcrumbs =
    [
        new("Trang Chủ", href: RouterConfig.Admin.Home),
        new("Khách Hàng", href: RouterConfig.Admin.Customer),
        new("Tạo Khách Hàng", href: "#", disabled: true),
    ];
}
