@page "/admin/order"
@layout AdminLayout

<PageTitle>@Constant.PageTitleAdmin Order</PageTitle>

<section class="p-6">
    <div class="flex items-center justify-between">
        <h1 class="leading-[3rem] text-material-default h-12 text-3xl font-bold">Danh sách hóa đơn</h1>
    </div>

    <div class="mt-8 rounded bg-white p-6 shadow-md">
        <div class="grid w-full grid-cols-3 items-start gap-x-6 gap-y-4">
            <div>
                <MudTextField T="string" Placeholder="Tìm kiếm" Adornment="Adornment.Start" Value="@_searchValue"
                              AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" IconSize="Size.Medium" Class="mt-0" Margin="Margin.Dense" ValueChanged="onChangeSearch" Immediate=true></MudTextField>
            </div>
            <div>
                <MudSelect class="mt-0" T="int" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="@_searchStatus">
                    <MudSelectItem Value="0">Tất cả</MudSelectItem>
                    <MudSelectItem Value="1">Hoàn thành</MudSelectItem>
                    <MudSelectItem Value="2">Chờ thanh toán</MudSelectItem>
                    <MudSelectItem Value="3">Đã hủy</MudSelectItem>
                </MudSelect>
            </div>
            <div>
                <MudDatePicker Class="!mt-0" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Placeholder="Ngày bắt đầu" Date="@_startDate" DateChanged="OnChangeStartDate" MaxDate="@_maxStartDate" />
            </div>
            <div>
                <MudDatePicker Class="!mt-0" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Placeholder="Ngày kết thúc" Date="@_endDate" DateChanged="OnChangeEndDate" MinDate="@_minEndDate" />
            </div>
            <div class="flex items-center gap-2">
                <MudButton Variant="Variant.Outlined" OnClick="OnSearch" Class="h-10 w-full"><MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" /> Tìm kiếm</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="OnReset" Class="h-10 w-full"><MudIcon Icon="@Icons.Material.Filled.Filter" Class="mr-2" /> Đặt lại</MudButton>
            </div>
        </div>
    </div>

    <div class="mt-8 rounded bg-white shadow-md">
        <MudTable Items="@_lstOrder"
                  Elevation="0"
                  Loading="@_isLoading"
                  Hover="true"
                  Virtualize="true"
                  FixedHeader="true"
                  HorizontalScrollbar="true"
                  Height="calc(100lvh - 425px)">
            <HeaderContent>
                <MudTh hidden>ID</MudTh>
                <MudTh>Mã hóa đơn</MudTh>
                <MudTh>Thời gian</MudTh>
                <MudTh>Khách hàng</MudTh>
                <MudTh Style="text-align:right">Chiết Khấu</MudTh>
                <MudTh Style="text-align:right">Dùng điểm</MudTh>
                <MudTh Style="text-align:right">Tổng tiền</MudTh>
                <MudTh Style="text-align:center">Trạng thái</MudTh>
                <MudTh>Ghi chú</MudTh>
                <MudTh>Chi tiết</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID" hidden>@context.OrderId</MudTd>
                <MudTd DataLabel="Mã hóa đơn">@context.OrderCode</MudTd>
                <MudTd DataLabel="Tài khoản">@context.User.FullName - @context.User.PhoneNumber</MudTd>
                <MudTd DataLabel="Thời gian">@context.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
                <MudTd DataLabel="Chiết Khấu" Style="text-align:right">@context.DiscountAmount.ToString("C0", vietnameseCulture)</MudTd>
                <MudTd DataLabel="Dùng điểm" Style="text-align:right">@context.UsedRewardPoint.ToString("N0")</MudTd>
                <MudTd DataLabel="Tổng tiền" Style="text-align:right" Class="font-bold">@context.FinalAmount.ToString("C0", vietnameseCulture)</MudTd>
                <MudTd DataLabel="Trạng thái" Style="text-align:center">
                    <span class="@GetStatusStyle(context.Status)">
                        @GetStatusName(context.Status)
                    </span>
                </MudTd>
                <MudTd DataLabel="Ghi chú">@context.Note</MudTd>
                <MudTd DataLabel="Ghi chú">
                    <AuthorizeControl Action="@Constant.ActionButton.Read">
                        <MudIconButton Color="Color.Primary" Icon="@Icons.Material.Filled.Menu" aria-label="detail" OnClick="@(() => navigation.NavigateTo(RouterConfig.Admin.OrderDetail.Replace(":id", context.OrderId.ToString())))"></MudIconButton>
                    </AuthorizeControl>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="my-4" Color="Color.Inherit">Không có dữ liệu.</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <div class="flex w-full flex-col gap-3 opacity-50">
                    @for (var i = 0; i < 5; i++)
                    {
                        <div class="flex items-center justify-between gap-2 px-2">
                            <MudSkeleton Width="100%" Height="5rem" />
                            <MudSkeleton Width="100%" Height="5rem" />
                            <MudSkeleton Width="100%" Height="5rem" />
                            <MudSkeleton Width="100%" Height="5rem" />
                        </div>
                    }
                </div>
            </LoadingContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </div>
</section>

@code {

    [CascadingParameter(Name = Constant.CascadingNameParams.Token)]
    public string _token { get; set; }

    List<OrderWithDetailResponse> _lstOrder = [];


    private string _searchValue = string.Empty;
    private int _searchStatus = 0;
    private DateTime? _startDate = DateTime.Now.AddMonths(-6);
    private DateTime? _endDate = DateTime.Now.AddMonths(6);
    private DateTime? _maxStartDate = DateTime.Now.AddMonths(6);
    private DateTime? _minEndDate = DateTime.Now.AddMonths(-6);
    private bool _isLoading = false;

    System.Globalization.CultureInfo vietnameseCulture = new System.Globalization.CultureInfo("vi-VN");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            await LoadData();
        }
        catch (Exception) { }
        finally
        {
            _isLoading = false;
        }
    }

    async Task LoadData()
    {
        var resOrder = await _adminOrderService.GetAllByKeyword(_token, _searchStatus, _searchValue, _startDate, _endDate);
        if (resOrder.IsSuccess)
        {
            _lstOrder = resOrder.Data.OrderByDescending(x => x.OrderDate).ToList();
        }
    }

    private void onChangeSearch(string value)
    {
        _searchValue = value.Trim();
    }

    private async Task OnSearch()
    {
        await LoadData();
    }

    private void OnChangeStartDate(DateTime? value)
    {
        _startDate = value;
        _minEndDate = value;
    }

    private void OnChangeEndDate(DateTime? value)
    {
        _endDate = value;
        _maxStartDate = value;
    }

    private async Task OnReset()
    {
        _searchValue = string.Empty;
        _searchStatus = 0;
        _startDate = DateTime.Now.AddMonths(-6);
        _endDate = DateTime.Now;
        _maxStartDate = DateTime.Now;
        _minEndDate = DateTime.Now.AddMonths(-6);
        await LoadData();
    }

    private string GetStatusStyle(int status)
    {
        string baseClass = "font-medium uppercase px-2 py-1 rounded-md ";
        return status switch
        {
            1 => baseClass + "text-green-500",      // Hoàn thành
            2 => baseClass + "text-black",          // Chờ thanh toán
            3 => baseClass + "text-red-500",        // Huỷ
            _ => baseClass + "text-gray-400"
        };
    }

    private string GetStatusName(int status)
    {
        return status switch
        {
            1 => "Hoàn thành",
            2 => "Chờ thanh toán",
            3 => "Đã hủy",
            _ => "Không xác định"
        };
    }
}