@page "/admin/game/create"
@layout AdminLayout

<PageTitle>@Constant.PageTitleAdmin Game Create</PageTitle>

<section class="mx-auto max-w-[1280px] p-6">
    <h1 class="leading-[3rem] mb-4 h-12 text-3xl font-bold text-material-default">Tạo game mới</h1>

    <div class="rounded bg-white p-10 shadow-md">
        <MudForm Model="_model" @ref="_form" Validation="_gameSchema.ValidateValue">
            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Tiêu đề</label> <span class="ml-1 text-red-500">*</span>

                <MudTextField T="string"
                              @bind-Value="_model.Title"
                              For="@(() => _model.Title)"
                              Variant="Variant.Outlined"
                              Placeholder="Ví dụ: Wuchang: Fallen Feathers – Deluxe Edition..."
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Nhà phát triển</label> <span class="ml-1 text-red-500">*</span>

                <MudTextField T="string"
                              @bind-Value="_model.Developer"
                              For="@(() => _model.Developer)"
                              Variant="Variant.Outlined"
                              Placeholder="Ví dụ: ..."
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Thể loại</label> <span class="ml-1 text-red-500">*</span>

                <MudSelect T="int" MultiSelectionTextFunc="@GetMultiSelectionTextCategory" @bind-SelectedValues="_categoryIds" MultiSelection="true" SelectAll="true" Variant="Variant.Outlined" Placeholder="Hành động, chiến thuật..." Margin="Margin.Dense">
                    @if (_lstCategory.Any())
                    {
                        @foreach(var item in _lstCategory)
                        {
                            <MudSelectItem T="int" Value="@item.CategoryId">@item.CategoryName</MudSelectItem>
                        }
                    }
                </MudSelect>
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Nền tảng</label> <span class="ml-1 text-red-500">*</span>

                <MudSelect T="int" MultiSelectionTextFunc="@GetMultiSelectionTextPlatform" @bind-SelectedValues="_platformIds" MultiSelection="true" SelectAll="true" Variant="Variant.Outlined" Placeholder="nintendo, ps5..." Margin="Margin.Dense">
                    @if (_lstPlatform.Any())
                    {
                        @foreach (var item in _lstPlatform)
                        {
                            <MudSelectItem T="int" Value="@item.PlatformId">@item.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Nhà phat hành</label> <span class="ml-1 text-red-500">*</span>

                <MudSelect T="int" @bind-Value="_model.PublisherId" For="@(() => _model.PublisherId)" Variant="Variant.Outlined" Placeholder="Riot Games" Margin="Margin.Dense">
                    @if (_lstPublisher.Any())
                    {
                        @foreach (var item in _lstPublisher)
                        {
                            <MudSelectItem Value="@item.PublisherId">@item.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Thời gian phát hành</label> <span class="ml-1 text-red-500">*</span>

                <MudDatePicker @bind-Date="_model.ReleaseDate" DateFormat="dd/MM/yyyy" Placeholder="01/01/2026" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Mô tả</label>

                <RichTextEditor @bind-Content="@_model.Description"
                                Placeholder="Nhập mô tả về game này..."
                                ToolbarOptions="@ToolbarOptions.FullToolbarOptions"
                                Theme="@QuillTheme.Snow" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Ảnh</label> <span class="ml-1 text-red-500">*</span>

                <div class="flex flex-col gap-4">
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       ButtonType="ButtonType.Button"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       Disabled="@(_imagesWithUrl != null && !string.IsNullOrEmpty(_imagesWithUrl.Url))">
                                Thêm Ảnh
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    @if (_imagesWithUrl != null && !string.IsNullOrEmpty(_imagesWithUrl.Url))
                    {
                        <div class="relative flex max-w-40 items-center overflow-hidden rounded-lg border-2 border-gray-300">
                            <MudImage Src="@_imagesWithUrl.Url" Alt="image game" ObjectFit="ObjectFit.Cover" Class="!aspect-[1/1.6]" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="@(() => HandleRemoveImages(_imagesWithUrl.File))"
                                            Class="absolute top-1 right-1 text-white !p-0" />
                        </div>
                    }
                </div>
            </div>


            <MudDivider Class="mb-8 mt-4 !border-slate-200" />

            <div class="flex items-center justify-end gap-3">
                <MudButton Variant="Variant.Text"
                           Class="px-6 py-2 text-slate-500 hover:bg-slate-200"
                           OnClick="() => navigation.NavigateTo(RouterConfig.Admin.Game)">
                    Quay lại
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(async () => await OnSubmit())"
                           Disabled="@_isLoading"
                           Class="px-8 py-2.5 font-bold shadow-lg shadow-material-default/20">
                    Tạo mới
                </MudButton>
            </div>
        </MudForm>
    </div>
</section>

@code {
    [Inject]
    public IWebHostEnvironment WebHostEnvironment { get; set; }

    MudForm _form = new MudForm();
    GameModel _model = new GameModel();
    GameSchema.CreateUpdate _gameSchema = new GameSchema.CreateUpdate();
    List<DAL.Models.Category> _lstCategory = [];
    List<DAL.Models.Platform> _lstPlatform = [];
    List<DAL.Models.Publisher> _lstPublisher = [];
    ImageFileResponse _imagesWithUrl = null;


    private IEnumerable<int> _categoryIds = new HashSet<int>();
    private IEnumerable<int> _platformIds = new HashSet<int>();
    private bool _isLoading = false;
    private int MaxAllowedSize = 1024 * 1024 * 5;
    private bool _isSubmitting = false;
    string _content = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        StateHasChanged();
    }

    async Task LoadData()
    {
        _model.PublisherId = -1;
        var resCategory = await _adminCategoryService.GetAll();
        if(resCategory.IsSuccess && resCategory.Data.Any())
        {
            _lstCategory = resCategory.Data;
        }
        var resPlatform = await _adminPlatformService.GetAll();
        if (resPlatform.IsSuccess && resPlatform.Data.Any())
        {
            _lstPlatform = resPlatform.Data;
        }
        var resPublisher = await _adminPublisherService.GetAll();
        if (resPublisher.IsSuccess && resPublisher.Data.Any())
        {
            _lstPublisher = resPublisher.Data;
        }
    }

    private async Task UploadFiles(IBrowserFile file)
    {
        try
        {
            _isLoading = true;
            if (file.Size > MaxAllowedSize)
            {
                _snackbar.Add("Ảnh không được quá 5mb", MudBlazor.Severity.Warning);
                return;
            }

            var url = await Task.Run(async () =>
            {
                using var stream = file.OpenReadStream(MaxAllowedSize);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);

                var base64String = Convert.ToBase64String(memoryStream.ToArray());
                return $"data:{file.ContentType};base64,{base64String}";
            });

            _imagesWithUrl = new ImageFileResponse { File = file, Url = url };
            StateHasChanged();
        }
        catch (Exception)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleRemoveImages(IBrowserFile file)
    {
        try
        {
            _isLoading = true;
            _imagesWithUrl = new ImageFileResponse();
            StateHasChanged(); 
        } catch (Exception)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    async Task OnSubmit()
    {
        if (_isLoading) return;

        try
        {
            _isLoading = true;
            await _form.Validate();

            if (!_form.IsValid) return;

            if (_imagesWithUrl.File == null || string.IsNullOrEmpty(_imagesWithUrl.Url))
            {
                _snackbar.Add("Vui lòng thêm ảnh", MudBlazor.Severity.Warning);
                return;
            }

            if(!_categoryIds.Any() || !_platformIds.Any())
            {
                _snackbar.Add("Vui lòng điền đầy đủ thông tin", MudBlazor.Severity.Warning);
                return;

            }

            List<GamePlatformInputModel> lstPlatform = new List<GamePlatformInputModel>();
            foreach(var item in _platformIds)
            {
                var find = _lstPlatform.FirstOrDefault(x => x.PlatformId == item);
                var platform = new GamePlatformInputModel
                {
                    PlatformId = item,
                    Description = find != null ? find.Description : "",
                };
                lstPlatform.Add(platform);
            }

            _model.Title = _model.Title.Trim();
            _model.Developer = _model.Developer.Trim();
            _model.CategoryIds = _categoryIds.ToList();
            _model.Platforms = lstPlatform;
            _model.Status = Constant.StatusDefault.CommingSoon;

            var fileName = Path.GetFileName(_imagesWithUrl.File.Name);
            var randomId = Guid.NewGuid().ToString().Substring(0, 8);
            _model.Thumbnail = Constant.MainImages + randomId + "/" + fileName;

            var res = await _adminGameService.CreateGame(_model);

            if(res.IsSuccess && res.Data != null)
            {
                var contentRootPath = WebHostEnvironment.WebRootPath;
                var productImagesPath = Path.Combine(contentRootPath, "uploads", "images", "games", randomId);

                if (!Directory.Exists(productImagesPath))
                {
                    Directory.CreateDirectory(productImagesPath);
                }

                var filePath = Path.Combine(productImagesPath, fileName);

                await using Stream fileStream = _imagesWithUrl.File.OpenReadStream(MaxAllowedSize);
                await using FileStream fs = File.Create(filePath);
                await fileStream.CopyToAsync(fs);

                _categoryIds = new HashSet<int>();
                _platformIds = new HashSet<int>();
                _imagesWithUrl = new ImageFileResponse();
                _snackbar.Add("Tạo thành công", MudBlazor.Severity.Success);
                navigation.NavigateTo(RouterConfig.Admin.Game);
            }
            else
            {
                _snackbar.Add("Tạo thất bại", MudBlazor.Severity.Error);
            }
        }
        catch (Exception)
        {
            _isLoading = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetMultiSelectionTextCategory(IEnumerable<string> selectedValues)
    {
        var selectedIds = selectedValues.Select(int.Parse).ToList();

        var names = _lstCategory
            .Where(x => selectedIds.Contains(x.CategoryId))
            .Select(x => x.CategoryName);

        return string.Join(", ", names);
    }

    private string GetMultiSelectionTextPlatform(IEnumerable<string> selectedValues)
    {
        var selectedIds = selectedValues.Select(int.Parse).ToList();

        var names = _lstPlatform
            .Where(x => selectedIds.Contains(x.PlatformId))
            .Select(x => x.Name);

        return string.Join(", ", names);
    }
}

<style>
    .reset-css,
    .reset-css * {
        all: unset;
        all: revert;
        box-sizing: border-box;
    }
</style>
