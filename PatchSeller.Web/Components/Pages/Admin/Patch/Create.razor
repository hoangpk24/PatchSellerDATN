@page "/admin/patch/create"
@layout AdminLayout

<PageTitle>@Constant.PageTitleAdmin Patch Create</PageTitle>

<section class="mx-auto max-w-[1280px] p-6">
    <h1 class="leading-[3rem] mb-4 h-12 text-3xl font-bold text-material-default">Tạo gói mới</h1>

    <div class="rounded bg-white p-10 shadow-md">
        <MudForm Model="_model" @ref="_form" Validation="_patchSchema.ValidateValue">
            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Tên</label> <span class="ml-1 text-red-500">*</span>
                <MudTextField T="string"
                              @bind-Value="_model.Name"
                              For="@(() => _model.Name)"
                              Variant="Variant.Outlined"
                              Placeholder="Ví dụ: Gói việt hóa..."
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Giá</label> <span class="ml-1 text-red-500">*</span>
                <MudNumericField @bind-Value="_model.Price"
                                 For="@(() => _model.Price)"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Adornment="Adornment.End"
                                 Format="F0" Step="1000"
                                 AdornmentText="đ"
                                 HideSpinButtons="true"
                                 Placeholder="179000" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Mô tả chi tiết</label>
                <MudTextField T="string"
                              @bind-Value="_model.Description"
                              For="@(() => _model.Description)"
                              Placeholder="Nhập mô tả ngắn gọn về gói này..."
                              Variant="Variant.Outlined"
                              Lines="4"
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Thuộc game</label> <span class="ml-1 text-red-500">*</span>
                <MudSelect class="mt-0" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="@_model.GameId">
                    <MudSelectItem Value="0">UnKnow</MudSelectItem>
                    @if (_lstGame.Any())
                    {
                        @foreach (var rank in _lstGame)
                        {
                            <MudSelectItem Value="@rank.GameId">@rank.Title</MudSelectItem>
                        }
                    }
                </MudSelect>
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Ảnh</label> <span class="ml-1 text-red-500">*</span>

                <div class="flex flex-col gap-4">
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       ButtonType="ButtonType.Button"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       Disabled="@(_imagesWithUrl != null && !string.IsNullOrEmpty(_imagesWithUrl.Url))">
                                Thêm Ảnh
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    @if (_imagesWithUrl != null && !string.IsNullOrEmpty(_imagesWithUrl.Url))
                    {
                        <div class="relative flex max-w-40 items-center overflow-hidden rounded-lg border-2 border-gray-300">
                            <MudImage Src="@_imagesWithUrl.Url" Alt="image game" ObjectFit="ObjectFit.Cover" Class="!aspect-[1/1.6]" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="@(() => HandleRemoveImages(_imagesWithUrl.File))"
                                           Class="absolute top-1 right-1 text-white !p-0" />
                        </div>
                    }
                </div>
            </div>

            <MudDivider Class="mb-8 mt-4 !border-slate-200" />

            <div class="flex items-center justify-end gap-3">
                <MudButton Variant="Variant.Text"
                           Class="px-6 py-2 text-slate-500 hover:bg-slate-200"
                           OnClick="() => navigation.NavigateTo(RouterConfig.Admin.Patch)">
                    Quay lại
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(async () => await OnSubmit())"
                           Disabled="@_isLoading"
                           Class="px-8 py-2.5 font-bold shadow-lg shadow-material-default/20">
                    Tạo mới
                </MudButton>
            </div>
        </MudForm>
    </div>
</section>

@code {
    [Inject]
    public IWebHostEnvironment WebHostEnvironment { get; set; }

    [CascadingParameter(Name = Constant.CascadingNameParams.Mine)]
    public MineResponse _mine { get; set; }
    [CascadingParameter(Name = Constant.CascadingNameParams.Token)]
    public string _token { get; set; }

    MudForm _form = new MudForm();
    PatchModel _model = new PatchModel();
    List<DAL.Models.Game> _lstGame = new List<DAL.Models.Game>();
    PatchSchema.CreateUpdate _patchSchema = new PatchSchema.CreateUpdate();
    ImageFileResponse _imagesWithUrl = null;

    private int MaxAllowedSize = 1024 * 1024 * 5;
    private bool _isLoading = false;

    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            await LoadData();
            StateHasChanged();
        }
        catch(Exception) {}
        finally
        {
            _isLoading = false;
        }
    }
    async Task LoadData()
    {
        var resGame = await _adminGameService.GetAll();

        if(resGame.IsSuccess && resGame.Data.Any())
        {
            _lstGame = resGame.Data;
            _model.GameId = resGame.Data.FirstOrDefault()?.GameId ?? 0;
        }
    }

    private async Task UploadFiles(IBrowserFile file)
    {
        try
        {
            _isLoading = true;
            if (file.Size > MaxAllowedSize)
            {
                _snackbar.Add("Ảnh không được quá 5mb", MudBlazor.Severity.Warning);
                return;
            }

            var url = await Task.Run(async () =>
            {
                using var stream = file.OpenReadStream(MaxAllowedSize);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);

                var base64String = Convert.ToBase64String(memoryStream.ToArray());
                return $"data:{file.ContentType};base64,{base64String}";
            });

            _imagesWithUrl = new ImageFileResponse { File = file, Url = url };
            StateHasChanged();
        }
        catch (Exception)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleRemoveImages(IBrowserFile file)
    {
        try
        {
            _isLoading = true;
            _imagesWithUrl = new ImageFileResponse();
            StateHasChanged();
        }
        catch (Exception)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    async Task OnSubmit()
    {
        if (_isLoading) return;

        try
        {
            _isLoading = true;

            await _form.Validate();

            if (!_form.IsValid) return;

            if (_imagesWithUrl.File == null || (_imagesWithUrl.File != null && string.IsNullOrEmpty(_imagesWithUrl.Url)))
            {
                _snackbar.Add("Vui lòng thêm ảnh", MudBlazor.Severity.Warning);
                return;
            }

            _model.Name = _model.Name.Trim();
            _model.Description = _model.Description.Trim();
            _model.Status = Constant.StatusDefault.InActive;
            _model.UpdateBy = _mine.FullName ?? "";


            var fileName = Path.GetFileName(_imagesWithUrl.File.Name);
            var randomId = Guid.NewGuid().ToString().Substring(0, 8);
            _model.ThumbnailLink = Constant.MainPatchImages + randomId + "/" + fileName;

            var response = await _adminPatchService.CreatePatch(_model, _token);

            if (response.IsSuccess)
            {
                var contentRootPath = WebHostEnvironment.WebRootPath;
                var productImagesPath = Path.Combine(contentRootPath, "uploads", "images", "patches", randomId);

                if (!Directory.Exists(productImagesPath))
                {
                    Directory.CreateDirectory(productImagesPath);
                }

                var filePath = Path.Combine(productImagesPath, fileName);

                await using Stream fileStream = _imagesWithUrl.File.OpenReadStream(MaxAllowedSize);
                await using FileStream fs = File.Create(filePath);
                await fileStream.CopyToAsync(fs);
                _imagesWithUrl = new ImageFileResponse();

                _snackbar.Add("Tạo thành công!", MudBlazor.Severity.Success);
                navigation.NavigateTo(RouterConfig.Admin.Patch);
            }
            else
            {
                var mess = string.IsNullOrEmpty(response.ErrorMessage) ? "Tạo thất bại" : response.ErrorMessage;
                _snackbar.Add(mess, MudBlazor.Severity.Error);
            }
        }
        catch (Exception)
        {
            _isLoading = false;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
