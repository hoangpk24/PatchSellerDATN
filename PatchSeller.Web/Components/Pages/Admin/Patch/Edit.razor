@page "/admin/patch/{id:int}/edit"
@layout AdminLayout

<PageTitle>@Constant.PageTitleAdmin Patch Edit</PageTitle>

<section class="p-6">
    <h1 class="leading-[3rem] text-3xl font-bold text-material-default">Sửa gói</h1>

    <div class="rounded bg-white p-10 shadow-md">
        <MudForm Model="_model" @ref="_form" Validation="_patchSchema.ValidateValue">
            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Tên</label> <span class="ml-1 text-red-500">*</span>
                <MudTextField T="string"
                              @bind-Value="_model.Name"
                              For="@(() => _model.Name)"
                              Variant="Variant.Outlined"
                              Placeholder="Ví dụ: Gói..."
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Giá</label> <span class="ml-1 text-red-500">*</span>
                <MudNumericField @bind-Value="_model.Price"
                                 For="@(() => _model.Price)"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Adornment="Adornment.End"
                                 Format="F0" Step="1000"
                                 AdornmentText="đ"
                                 HideSpinButtons="true"
                                 Placeholder="179000" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Mô tả chi tiết</label>
                <MudTextField T="string"
                              @bind-Value="_model.Description"
                              For="@(() => _model.Description)"
                              Placeholder="Nhập mô tả ngắn gọn về gói này..."
                              Variant="Variant.Outlined"
                              Lines="4"
                              Margin="Margin.Dense" />
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Thuộc game</label> <span class="ml-1 text-red-500">*</span>
                <MudSelect class="mt-0" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="@_model.GameId" Disabled>
                    <MudSelectItem Value="0">UnKnow</MudSelectItem>
                    @if (_lstGame.Any())
                    {
                        @foreach (var rank in _lstGame)
                        {
                            <MudSelectItem Value="@rank.GameId">@rank.Title</MudSelectItem>
                        }
                    }
                </MudSelect>
            </div>

            <div class="mb-6">
                <label class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-700">Ảnh</label> <span class="ml-1 text-red-500">*</span>

                <div class="flex flex-col gap-4">
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       ButtonType="ButtonType.Button"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       Disabled="@(_imagesWithUrl != null && !string.IsNullOrEmpty(_imagesWithUrl.Url))">
                                Thêm Ảnh
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    @if (!string.IsNullOrEmpty(_imagesWithUrl?.Url))
                    {
                        <div class="relative flex max-w-40 items-center overflow-hidden rounded-lg border-2 border-gray-300">
                            <MudImage Src="@_imagesWithUrl.Url" Alt="image game" ObjectFit="ObjectFit.Cover" Class="!aspect-[1/1.6]" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="@(() => HandleRemoveImages(_imagesWithUrl.File))"
                                           Class="absolute top-1 right-1 text-white !p-0" />
                        </div>
                    }
                </div>
            </div>

            <div class="mb-6">
                <label class="mb-2 block text-sm font-bold uppercase tracking-wider text-slate-700">Trạng thái hiển thị</label>

                <MudRadioGroup Disabled="_isDisableStatus" T="int" @bind-Value="_model.Status" For="@(() => _model.Status)">
                    <div class="flex gap-6">
                        <MudRadio Value="1" Color="Color.Primary" Class="!ml-0">
                            <span class="text-sm font-medium text-slate-600">Hoạt động</span>
                        </MudRadio>
                        <MudRadio Value="0" Color="Color.Error">
                            <span class="text-sm font-medium text-slate-600">Tạm ngưng</span>
                        </MudRadio>
                    </div>
                </MudRadioGroup>

                @if (_isDisableStatus)
                {
                    <p class="mt-1 text-xs italic text-red-500">
                        * Không thể chuyển trạng thái "Hoạt động" vì gói này chưa có phiên bản (Patch Version) nào.
                    </p>
                }
            </div>

            <MudDivider Class="mb-8 mt-4 !border-slate-200" />

            <div class="flex items-center justify-end gap-3">
                <MudButton Variant="Variant.Text"
                           Class="px-6 py-2 text-slate-500 hover:bg-slate-200"
                           OnClick="() => navigation.NavigateTo(RouterConfig.Admin.Patch)">
                    Quay lại
                </MudButton>
                <AuthorizeControl Action="@Constant.ActionButton.Edit">
                    <MudButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Edit"
                            OnClick="@(async () => await OnSubmit())"
                            Disabled="@_isLoading"
                            Class="px-8 py-2.5 font-bold shadow-lg shadow-material-default/20">
                            Sửa
                    </MudButton>
                </AuthorizeControl>
            </div>
        </MudForm>
    </div>
</section>

@code {

    [Inject]
    public IWebHostEnvironment WebHostEnvironment { get; set; }

    [Parameter]
    public int id { get; set; }
    [CascadingParameter(Name = Constant.CascadingNameParams.Mine)]
    public StaffGetMe _mine { get; set; }
    [CascadingParameter(Name = Constant.CascadingNameParams.Token)]
    public string _token { get; set; }

    MudForm _form = new MudForm();
    PatchModel _model = new PatchModel();
    PatchDetailResponse _patchDetail = new PatchDetailResponse();
    List<DAL.Models.Game> _lstGame = new List<DAL.Models.Game>();
    PatchSchema.CreateUpdate _patchSchema = new PatchSchema.CreateUpdate();
    ImageFileResponse _imagesWithUrl = new ImageFileResponse();

    private string _oldImageUrl = string.Empty;
    private bool _isLoading = false;
    private int MaxAllowedSize = 1024 * 1024 * 5; 
    private bool _isDisableStatus = false; 
    private bool _isImageRemoved = false;

    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            await LoadData();
            StateHasChanged();
        }
        catch (Exception) { }
        finally
        {
            _isLoading = false;
        }
    }
    async Task LoadData()
    {
        var resGame = await _adminGameService.GetAll();

        if (resGame.IsSuccess && resGame.Data.Any())
        {
            _lstGame = resGame.Data;
            _model.GameId = resGame.Data.FirstOrDefault()?.GameId ?? 0;
        }

        var resPatch = await _adminPatchService.GetDetailById(id);
        if (resPatch.IsSuccess && resPatch.Data != null)
        {
            _patchDetail = resPatch.Data; 
            _isDisableStatus = _patchDetail.PatchVersions == null || !_patchDetail.PatchVersions.Any();
            _model = new PatchModel             
            {
                PatchId = resPatch.Data.PatchId,
                Name = resPatch.Data.Name,
                Description = resPatch.Data.Description,
                Price = resPatch.Data.Price,
                GameId = resPatch.Data.Game.GameId,
                Status = resPatch.Data.Status,
                CreatedAt = resPatch.Data.CreatedAt,
            };
            _imagesWithUrl = new ImageFileResponse
            {
                File = null,
                Url = resPatch.Data.ThumbnailLink,
            };
            _oldImageUrl = resPatch.Data.ThumbnailLink;

            _isImageRemoved = false;
        }
        else if (resPatch.IsSuccess == false && resPatch.StatusCode == "NotFound")
        {
            _snackbar.Add("Không tìm thấy này.", MudBlazor.Severity.Error);
            navigation.NavigateTo(RouterConfig.NotFound);
        }
        else
        {
            _snackbar.Add("Đã có lỗi xảy ra. Vui lòng báo cho khách hàng.", MudBlazor.Severity.Error);
            navigation.NavigateTo(RouterConfig.Admin.Staff);
        }
    }


    private async Task UploadFiles(IBrowserFile file)
    {
        try
        {
            _isLoading = true;
            if (file.Size > MaxAllowedSize)
            {
                _snackbar.Add("Ảnh không được quá 5mb", MudBlazor.Severity.Warning);
                return;
            }

            var url = await Task.Run(async () =>
            {
                using var stream = file.OpenReadStream(MaxAllowedSize);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);

                var base64String = Convert.ToBase64String(memoryStream.ToArray());
                return $"data:{file.ContentType};base64,{base64String}";
            });
            _isImageRemoved = false;
            _imagesWithUrl = new ImageFileResponse { File = file, Url = url };
            StateHasChanged();
        }
        catch (Exception)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleRemoveImages(IBrowserFile file)
    {
        try
        {
            _isLoading = true;
            _isImageRemoved = true;
            _imagesWithUrl = new ImageFileResponse();
            StateHasChanged();
        }
        catch (Exception)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    async Task OnSubmit()
    {
        if (_isLoading) return;

        try
        {
            _isLoading = true;

            await _form.Validate();

            if (!_form.IsValid) return;

            _model.Name = _model.Name.Trim();
            _model.Description = _model.Description.Trim();
            _model.UpdateBy = _mine.FullName ?? "";

            var isNewImages = _imagesWithUrl.File != null;
            var randomId = Guid.NewGuid().ToString().Substring(0, 8);

            if (isNewImages)
            {
                var fileName = Path.GetFileName(_imagesWithUrl.File.Name);
                _model.ThumbnailLink = Constant.MainPatchImages + randomId + "/" + fileName;
            }
            else if (_isImageRemoved)
            {
                _model.ThumbnailLink = string.Empty;
            }
            else
            {
                _model.ThumbnailLink = _oldImageUrl;
            }

            var response = await _adminPatchService.UpdatePatch(_model, _token);

            if (response.IsSuccess)
            {
                if (isNewImages)
                {
                    await SaveFileToDisk(randomId);
                    DeleteOldImageFolder(_oldImageUrl);
                }
                else if (_isImageRemoved)
                {
                    DeleteOldImageFolder(_oldImageUrl);
                }
                _imagesWithUrl = new ImageFileResponse();

                _snackbar.Add("Sửa thành công!", MudBlazor.Severity.Success);
                navigation.NavigateTo(RouterConfig.Admin.Patch);
            }
            else
            {
                var mess = string.IsNullOrEmpty(response.ErrorMessage) ? "Sửa thất bại" : response.ErrorMessage;
                _snackbar.Add(mess, MudBlazor.Severity.Error);
            }
        }
        catch (Exception)
        {
            _isLoading = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveFileToDisk(string folderId)
    {
        var contentRootPath = WebHostEnvironment.WebRootPath;
        var path = Path.Combine(contentRootPath, "uploads", "images", "patches", folderId);

        if (!Directory.Exists(path)) Directory.CreateDirectory(path);

        var filePath = Path.Combine(path, _imagesWithUrl.File.Name);
        await using var stream = _imagesWithUrl.File.OpenReadStream(MaxAllowedSize);
        await using var fs = File.Create(filePath);
        await stream.CopyToAsync(fs);
    }

    private void DeleteOldImageFolder(string oldUrl)
    {
        if (string.IsNullOrEmpty(oldUrl)) return;

        try
        {
            var webRoot = WebHostEnvironment.WebRootPath;

            var relativePath = oldUrl.TrimStart('/').Replace("/", Path.DirectorySeparatorChar.ToString());
            var fullPath = Path.Combine(webRoot, relativePath);

            if (File.Exists(fullPath))
            {
                var directoryPath = Path.GetDirectoryName(fullPath);
                if (Directory.Exists(directoryPath))
                {
                    Directory.Delete(directoryPath, true);
                }
            }
        }
        catch (Exception)
        {
        }
    }
}
