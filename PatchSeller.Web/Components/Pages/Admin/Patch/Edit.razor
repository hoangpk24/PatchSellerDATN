@page "/admin/patch/{id:int}/edit"
@layout AdminLayout

<PageTitle>@Constant.PageTitleAdmin Patch Edit</PageTitle>

<section class="p-6">
    <MudBreadcrumbs Class="!p-0 !text-sm" Items="_itemBreadcrumbs" Separator=">"></MudBreadcrumbs>

    <h1 class="leading-[3rem] text-3xl font-bold text-material-default">Sửa gói việt hóa</h1>
</section>

@code {
    [Parameter]
    public int id { get; set; }

    private List<BreadcrumbItem> _itemBreadcrumbs =
    [
        new("Trang Chủ", href: RouterConfig.Admin.Home),
        new("Gói Việt Hóa", href: RouterConfig.Admin.Patch),
        new("Tạo Gói Việt Hóa", href: "#", disabled: true),
    ];
}
