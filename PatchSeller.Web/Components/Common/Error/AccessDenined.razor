@page "/access-denined"
@layout PublicLayout

<div class="min-h-screen bg-white">
    <div class="flex min-h-screen items-center justify-center px-6">
        <div class="w-full max-w-md text-center">
            <div class="mb-6">
                <svg class="mx-auto h-24 w-24 text-purple-500"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24"
                     xmlns="http://www.w3.org/2000/svg">
                    <path strokeLinecap="round"
                          strokeLinejoin="round"
                          strokeWidth={2}
                          d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>

            <div class="text-red-required mb-4 text-8xl font-bold text-red-500">403</div>

            <h2 class="mb-4 text-3xl font-bold text-slate-800">Access Denied</h2>

            <p class="mb-8 text-lg text-slate-600">
                Sorry, you do not have permission to access this page.
            </p>

            @if (_isShowHomeButton)
            {
                <MudButton Href="@_navigationRouter" Class="mt-2 !bg-purple-500" Variant="Variant.Filled">Home</MudButton>
            }
        </div>
    </div>
</div>


@code {
    private MineResponse _currentUserInfo = null;
    string _token = string.Empty;
    bool _isShowHomeButton = false;
    string _navigationRouter = RouterConfig.Admin.Home;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _token = await _localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
            var expired = await _localStorage.GetItemAsStringAsync(Constant.TokenExpiredLocalStorage);

            if (!string.IsNullOrEmpty(_token))
            {
                if (!string.IsNullOrEmpty(expired))
                {
                    if (DateTime.TryParse(expired.Trim('"'), out DateTime expirationTime))
                    {
                        if (expirationTime <= DateTime.Now)
                        {
                            await ClearLocalStorageAndNavigate(RouterConfig.Customer.Login);
                            return;
                        }
                    }
                }

                MineResponse getMe = null;
                try
                {
                    getMe = await _accessService.AccessCheck(_token.Trim('"'));
                }
                catch (Exception ex) when (ex is UnauthorizedAccessException || ex is HttpRequestException)
                {
                    await ClearLocalStorageAndNavigate(RouterConfig.Customer.Login);
                    return;
                }
                catch (Exception)
                {
                    await ClearLocalStorageAndNavigate(RouterConfig.Customer.Login);
                    return;
                }

                if (getMe != null && getMe.IsExpired)
                {
                    await ClearLocalStorageAndNavigate(RouterConfig.Customer.Login);
                    return;
                }
                if (getMe != null && getMe.Role == Constant.Role.Customer)
                {
                    _navigationRouter = RouterConfig.Customer.Home;
                }
                else
                {
                    _navigationRouter = RouterConfig.Admin.Home;
                }
            }
            else
            {
                _navigationRouter = RouterConfig.Customer.Home;
            }
            _isShowHomeButton = true;
            StateHasChanged();
        }
    }

    public async Task ClearLocalStorageAndNavigate(string route)
    {
        await _localStorage.RemoveItemAsync(Constant.TokenNameLocalStorage);
        await _localStorage.RemoveItemAsync(Constant.TokenExpiredLocalStorage);
        await _localStorage.RemoveItemAsync(Constant.UserInfoLocalStorage);
        _currentUserInfo = null;
        navigation.NavigateTo(route);
    }
}