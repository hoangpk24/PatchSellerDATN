<MudDialog Class="!bg-black-default">
    <TitleContent>
        <MudText Style="font-size: 18px; font-weight: bold; text-transform: uppercase; color: white">Đổi mật khẩu</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm Model="_model">
            <div class="mb-4">
                <label class="mb-1 block text-sm font-medium text-white">
                    Mật khẩu hiện tại
                </label>
                <MudTextField T="string"
                              @bind-Value="_model.CurrentPassword"
                              For="@(() => _model.CurrentPassword)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@(_passwordVisibility ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_passwordVisibility ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="TogglePasswordVisibility"
                              AdornmentAriaLabel="Show Password" />
            </div>
            <div class="mb-4">
                <label class="mb-1 block text-sm font-medium text-white">
                    Mật khẩu mới
                </label>
                <MudTextField T="string"
                              @bind-Value="_model.NewHashPassword"
                              For="@(() => _model.NewHashPassword)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@(_newPasswordVisibility ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_newPasswordVisibility ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="ToggleNewPasswordVisibility"
                              AdornmentAriaLabel="Show Password" />
            </div>
            <div class="mb-4">
                <label class="mb-1 block text-sm font-medium text-white">
                    Xác nhận mật khẩu mới
                </label>
                <MudTextField T="string"
                              @bind-Value="_model.ConfirmNewPassword"
                              For="@(() => _model.ConfirmNewPassword)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@(_newPasswordConfirmVisibility ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_newPasswordConfirmVisibility ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="ToggleNewPasswordConfirmVisibility"
                              AdornmentAriaLabel="Show Password" />
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="MudBlazor.Color.Surface" OnClick="Cancel" Class="!text-white">Đóng</MudButton>
        <MudButton OnClick="OnSubmit" Disabled="@_isLoading" Class="!text-purple-500">Đổi mật khẩu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string _token { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    CustomerChangePasswordModel _model = new CustomerChangePasswordModel();

    bool _isLoading = false;
    bool _passwordVisibility = false;
    bool _newPasswordVisibility = false;
    bool _newPasswordConfirmVisibility = false;

    private void TogglePasswordVisibility() => _passwordVisibility = !_passwordVisibility;
    private void ToggleNewPasswordVisibility() => _newPasswordVisibility = !_newPasswordVisibility;
    private void ToggleNewPasswordConfirmVisibility() => _newPasswordConfirmVisibility = !_newPasswordConfirmVisibility;

    async Task OnSubmit()
    {
        if (_isLoading)
        {
            return;
        }

        if (_model.NewHashPassword != _model.ConfirmNewPassword)
        {
            _snackbar.Add("Mật khẩu mới không khớp", MudBlazor.Severity.Error);
            return;
        }

        try
        {
            _isLoading = true;
            var response = await _accessService.ChangePassword(_model, _token);

            if (response.IsSuccess)
            {
                _snackbar.Add("Đổi mật khẩu thành công", MudBlazor.Severity.Success);
                MudDialog.Close();

            }
            else
            {
                _snackbar.Add(response.ErrorMessage, MudBlazor.Severity.Warning);
            }
        }
        catch (Exception)
        {
            _isLoading = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}

<style>
    .mud-input-outlined-border {
        border-color: rgba(156, 163, 175, 0.3) !important;
        border-radius: 9999px !important;
    }

    .mud-input-outlined {
        background-color: #242424 !important;
        border-radius: 9999px !important;
        color: white !important;
    }

    .mud-icon-button-label svg {
        margin: 0 !important;
        height: 100%;
        color: #a855f7 !important;
    }
</style>