<MudDialog Class="!bg-black-default">
    <TitleContent>
        <MudText></MudText>
    </TitleContent>
    <DialogContent>
        <div class="mx-auto flex max-w-[1520px] flex-col items-start gap-6 bg-black-default lg:flex-row md:gap-8 lg:gap-10">
            <div class="w-full lg:w-2/5">
                <img src="@_gameDetail.Thumbnail" alt="game" class="aspect-[1/1.5] rounded-lg object-cover shadow-2xl" />
            </div>

            <div class="w-full lg:w-3/5">
                <div class="w-full">
                    <h2 class="font-semibold leading-tight text-[32px] text-white">@_gameDetail.Title</h2>

                    @if (_gameDetail.Status != 2)
                    {
                        <div class="mt-6">
                            <MudSelect T="int" Variant="Variant.Outlined" Label="Options" Value="_patchSelect" ValueChanged="HandleChangePatch">
                                @if (_gameDetail.Patches != null && _gameDetail.Patches.Any())
                                {
                                    foreach (var item in _gameDetail.Patches)
                                    {
                                        <MudSelectItem Value="@item.PatchId">@item.Name</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </div>

                        <div class="mt-6">
                            @if (_isOwned)
                            {
                                <div class="flex w-fit items-center gap-3 rounded-full border border-green-500/20 bg-green-500/10 px-6 py-3 shadow-sm">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="text-green-500" />
                                    <span class="text-sm font-bold uppercase tracking-widest text-green-500">Đã sở hữu</span>
                                </div>
                            }
                            else
                            {
                                @if (_patchDetail != null)
                                {
                                    <div class="flex flex-col gap-6 rounded-2xl border border-white/10 bg-white/5 p-6">
                                        <span class="text-4xl font-bold text-purple-500">@_patchDetail.Price.ToString("C0", vietnameseCulture)</span>

                                        <div class="flex flex-wrap gap-4">
                                            <button @onclick="BuyNow" class="flex-1 rounded-full bg-purple-600 py-3.5 text-base font-bold text-white transition-all hover:bg-purple-700 active:scale-95">
                                                MUA NGAY
                                            </button>

                                            <button @onclick="AddToCart" class="flex h-[52px] w-[52px] items-center justify-center rounded-full border border-white/20 text-white transition-all hover:bg-white/10">
                                                <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Size="Size.Medium" />
                                            </button>

                                            <button class="flex h-[52px] w-[52px] items-center justify-center rounded-full border border-white/20 text-white transition-all hover:bg-white/10">
                                                <MudIcon Icon="@Icons.Material.Filled.FavoriteBorder" Size="Size.Medium" />
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <MudDivider Class="my-8 !border-white/10" />

                        @if (_isOwned)
                        {
                            @if (_patchDetail != null && _patchDetail.PatchVersions != null && _patchDetail.PatchVersions.Any())
                            {
                                <div class="flex flex-col gap-4">
                                    @foreach (var item in _patchDetail.PatchVersions)
                                    {
                                        <div class="group overflow-hidden rounded-2xl border border-white/5 bg-[#1a1a1a] transition-all hover:border-purple-500/50 hover:bg-[#222]">
                                            <div class="flex items-center justify-between p-5">
                                                <div class="flex items-center gap-4">
                                                    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-purple-500/10 text-purple-500">
                                                        <span class="text-xs font-bold uppercase">Ver</span>
                                                    </div>
                                                    <div>
                                                        <h3 class="text-lg font-bold text-white">@item.VersionName</h3>
                                                        <p class="text-xs text-white/40">Cập nhật mới nhất</p>
                                                    </div>
                                                </div>

                                                <a href="@item.Links" target="_blank"
                                                   class="flex items-center gap-2 rounded-full bg-purple-600 px-5 py-2 text-sm font-bold text-white transition-all hover:bg-purple-700 active:scale-95">
                                                    DOWNLOAD <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" />
                                                </a>
                                            </div>

                                            <div class="grid grid-cols-1 gap-6 border-t border-white/5 bg-black/20 p-6 md:grid-cols-3">
                                                <div class="space-y-2">
                                                    <div class="flex items-center gap-2 text-purple-400">
                                                        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
                                                        <span class="text-xs font-bold uppercase tracking-wider">Tóm tắt thay đổi</span>
                                                    </div>
                                                    <div class="text-sm leading-relaxed text-white/70">
                                                        @item.Changelog
                                                    </div>
                                                </div>

                                                <div class="space-y-2">
                                                    <div class="flex items-center gap-2 text-blue-400">
                                                        <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Small" />
                                                        <span class="text-xs font-bold uppercase tracking-wider">Hướng dẫn cài đặt</span>
                                                    </div>
                                                    <div class="text-sm leading-relaxed text-white/70">
                                                        @((MarkupString)item.InstallationGuide)
                                                    </div>
                                                </div>

                                                <div class="space-y-2">
                                                    <div class="flex items-center gap-2 text-amber-400">
                                                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                                        <span class="text-xs font-bold uppercase tracking-wider">Lưu ý quan trọng</span>
                                                    </div>
                                                    <div class="text-sm italic leading-relaxed text-white/50">
                                                        @item.Note
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="mt-6 overflow-hidden rounded-2xl border border-purple-500/20 bg-gradient-to-br from-purple-900/20 to-transparent p-8 shadow-2xl backdrop-blur-sm">
                            <div class="flex flex-col items-center text-center md:items-start md:text-left">
                                <div class="mb-4 flex h-14 w-14 animate-bounce items-center justify-center rounded-2xl bg-purple-500/10 text-purple-500">
                                    <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Size="Size.Large" />
                                </div>

                                <h3 class="font-black mb-2 text-3xl uppercase tracking-tighter text-white">
                                    Sắp ra mắt <span class="animate-pulse text-purple-500">...</span>
                                </h3>

                                <p class="max-w-md text-base leading-relaxed text-white/60">
                                    Siêu phẩm <strong class="text-white">@_gameDetail.Title</strong> đang trong giai đoạn hoàn thiện cuối cùng. Chúng tôi sẽ cập nhật các gói sản phẩm ngay khi game chính thức lên kệ.
                                </p>

                                <div class="mt-8 flex flex-wrap gap-4">
                                    <div class="flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-5 py-2.5">
                                        <div class="h-2 w-2 animate-ping rounded-full bg-purple-500"></div>
                                        <span class="text-sm font-medium text-white/80">Dự kiến: Sớm thôi</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [Parameter]
    public int gameId { get; set; }

    [Parameter]
    public int userId { get; set; }

    [Parameter]
    public int cartId { get; set; }

    [Parameter]
    public string token { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    GameDetailResponse _gameDetail = new GameDetailResponse();
    PatchBasicDTO _patchDetail = new PatchBasicDTO();

    int _patchSelect = 0;
    bool _isOwned = false;
    bool _isLoading = false;

    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    async Task LoadData()
    {
        var response = await _gameService.GetDetailById(gameId);
        if (response.IsSuccess)
        {
            _gameDetail = response.Data;

            if (_gameDetail.Patches.Any())
            {
                var obj = _gameDetail.Patches.FirstOrDefault();

                if (obj != null)
                {
                    _patchSelect = obj.PatchId;
                    _patchDetail = obj;
                }
            }
        }
    }

    async Task AddToCart()
    {
        if (token == null || userId == null)
        {
            _snackbar.Add("Vui lòng đăng nhập", MudBlazor.Severity.Warning);
            return;
        }

        if (_patchSelect == null || _patchSelect == 0)
        {
            _snackbar.Add("Vui lòng chọn gói muốn thêm", MudBlazor.Severity.Warning);
            return;
        }

        var payload = new AddCartModel
        {
            PatchId = _patchSelect,
            UserId = userId,
            CartId = cartId
        };

        var res = await _cartService.AddToCart(payload, token);

        if (res)
        {
            _snackbar.Add("Thêm thành công!", MudBlazor.Severity.Success);
            MudDialog.Close();
            await _cartActionService.LoadCartAsync(userId);
        }
        else
        {
            _snackbar.Add("Thêm thất bại!", MudBlazor.Severity.Error);
        }
    }

    async Task BuyNow()
    {
        if (token == null || userId == null)
        {
            _snackbar.Add("Vui lòng đăng nhập", MudBlazor.Severity.Warning);
            return;
        }

        if (_patchSelect == null || _patchSelect == 0)
        {
            _snackbar.Add("Vui lòng chọn gói muốn thêm", MudBlazor.Severity.Warning);
            return;
        }

        var payload = new AddCartModel
        {
            PatchId = _patchSelect,
            UserId = userId,
            CartId = cartId
        };

        var res = await _cartService.AddToCart(payload, token);

        if (res)
        {
            await _cartActionService.LoadCartAsync(userId);
            MudDialog.Close();
            navigation.NavigateTo(RouterConfig.Customer.Checkout);
        }
        else
        {
            _snackbar.Add("Đã có lỗi xảy ra, vui lòng thử lại!", MudBlazor.Severity.Error);
        }
    }

    void HandleChangePatch(int patchId)
    {
        try
        {
            _isLoading = true;
            _patchSelect = patchId;

            var obj = _gameDetail.Patches.Where(x => x.PatchId == patchId).FirstOrDefault();
            if (obj != null) _patchDetail = obj;
        }
        catch (Exception) { }
        finally
        {
            _isLoading = false;
        }
    }
}


