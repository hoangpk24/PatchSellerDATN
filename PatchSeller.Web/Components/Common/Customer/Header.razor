<header class="fixed top-0 z-20 w-full border-b border-white/5 bg-black-default">
    <div class="mx-auto flex max-w-[1520px] items-center justify-between gap-6 px-2 py-1 lg:pc-0 md:gap-0 lg:gap-0 md:px-0">
        <div class="flex-shrink-0">
            <a href="@RouterConfig.Customer.Home" class="hidden md:block lg:block">
                <img src="/assets/icons/logo.svg"
                     alt="AviGames Logo"
                     class="h-[72px] w-auto object-cover" />
            </a>
            <MudIcon @onclick="OpenHeaderDrawer" Icon="@Icons.Material.Filled.Menu" Class="!block cursor-pointer !text-white md:!hidden lg:!hidden" />
        </div>

        <nav class="hidden items-center gap-2 lg:flex md:flex">
            <ul class="flex flex-wrap items-center">
                <li class="flex-shrink-0 px-4 py-2">
                    <a href="@RouterConfig.Customer.Search" class="cursor-pointer font-bold text-[15px] text-white transition-colors hover:text-purple-500">Tất Cả</a>
                </li>
                <li class="group relative flex-shrink-0 cursor-pointer px-4 py-2">
                    <a class="flex items-center gap-1 font-bold text-[15px] text-white transition-colors group-hover:text-purple-500">
                        Thể Loại
                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                    </a>
                    <div class="absolute left-0 top-full z-50 hidden group-hover:block">
                        <div class="mt-4 border border-gray-800 bg-[#1e1e1e] p-2 shadow-2xl">
                            @if (_lstCategory != null && _lstCategory.Any())
                            {
                                <div class="grid max-h-[80vh] min-w-[200px] overflow-y-auto p-2"
                                     style="grid-template-columns: repeat(@(Math.Ceiling(_lstCategory.Count / 10.0)), minmax(180px, 1fr)); gap: 4px;">

                                    @foreach (var cat in _lstCategory)
                                    {
                                        <a href="@(RouterConfig.Customer.Search + "?" + $"cats={cat.CategoryId}")"
                                           class="block whitespace-nowrap rounded px-4 py-2 text-sm text-gray-300 transition-all hover:bg-purple-600 hover:text-white">
                                            @cat.CategoryName
                                        </a>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="px-4 py-2 text-sm text-gray-500">Đang tải...</div>
                            }
                        </div>
                    </div>
                </li>
                <li class="group relative flex-shrink-0 cursor-pointer px-4 py-2">
                    <a class="flex items-center gap-1 font-bold text-[15px] text-white transition-colors group-hover:text-purple-500">
                        Nền Tảng
                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                    </a>

                    <div class="absolute left-0 top-full z-50 hidden group-hover:block">
                        <div class="mt-4 border border-gray-800 bg-[#1e1e1e] p-2 shadow-2xl">
                            @if (_lstPlatform != null && _lstPlatform.Any())
                            {
                                <div class="scrollbar-thin scrollbar-thumb-purple-500 grid max-h-[70vh] min-w-[200px] overflow-y-auto p-2"
                                     style="grid-template-columns: repeat(@(Math.Ceiling(_lstPlatform.Count / 10.0)), minmax(180px, 1fr)); gap: 4px;">

                                    @foreach (var plat in _lstPlatform)
                                    {
                                        <a href="@(RouterConfig.Customer.Search + "?" + $"plats={plat.PlatformId}")"
                                           class="block whitespace-nowrap rounded px-4 py-2 text-sm text-gray-300 transition-all hover:bg-purple-600 hover:text-white">
                                            @plat.Name
                                        </a>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="w-[180px] px-4 py-3 text-sm italic text-gray-500">
                                    <div class="flex items-center gap-2">
                                        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
                                        Đang tải...
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </li>
                @if (_mine != null)
                {
                    <li class="group relative flex-shrink-0 cursor-pointer px-4 py-2">
                        <a href="@RouterConfig.Customer.DiscountCode" class="flex items-center gap-1 font-bold text-[15px] text-white transition-colors group-hover:text-purple-500">
                            Mã Giảm Giá
                        </a>
                    </li>
                }
            </ul>
        </nav>

        <div class="flex w-full items-center gap-6 md:w-auto lg:w-auto">
            <div class="relative flex w-full max-w-[500px] items-center rounded-full border border-gray-700 bg-[#1e1e1e] p-1 transition-all focus-within:border-purple-500 md:max-w-[300px] lg:max-w-[300px]">
                <input type="text"
                       @bind="_searchKeyword"
                       @onkeyup="HandleKeyUp"
                       placeholder="Tìm games bạn cần"
                       class="w-full bg-transparent py-1.5 pl-4 pr-10 text-sm font-light text-gray-200 placeholder-gray-500 outline-none" />

                <button @onclick="ExecuteSearch"
                        class="absolute right-1 flex h-8 w-8 items-center justify-center rounded-full bg-purple-500 text-white transition-transform hover:scale-105 active:scale-95">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                </button>
            </div>

            <div class="h-8 w-[1px] bg-gray-700 lg:block sm:hidden :md:block"></div>

            <div class="flex items-center gap-5">
                @if (_mine != null)
                {
                    <div class="group relative">
                        <MudAvatar Size="@Size.Medium" Class="cursor-pointer !bg-purple-500 !text-white">@GetInitials(_mine.FullName)</MudAvatar>
                        <div class="absolute left-0 top-full z-50 hidden min-w-[180px] group-hover:block">
                            <div class="mt-5 border border-gray-800 bg-[#1e1e1e] py-2 shadow-xl">
                                <a href="@RouterConfig.Customer.Profile" class="block px-4 py-2 text-sm text-gray-300 hover:bg-purple-600 hover:text-white">Thông tin tài khoản</a>
                                <MudDivider Class="!border-white/15"/>
                                <button @onclick="Logout" class="!w-full !justify-start !px-4 !py-2 !text-sm !text-gray-300 hover:!bg-purple-600 hover:!text-white">Đăng Xuất</button>
                            </div>
                        </div>
                    </div>
                    
                } else
                {
                    <a href="@RouterConfig.Customer.Login" class="flex cursor-pointer items-center gap-2 text-white transition-colors hover:text-purple-500">
                        <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Medium" />
                        @* <span class="whitespace-nowrap text-sm font-bold">Đăng nhập / Đăng ký</span> *@
                    </a>
                }

                <div @onclick="OpenCartDrawer" class="group relative flex cursor-pointer items-center gap-3">
                    <MudIcon Icon="@Icons.Material.Outlined.ShoppingCart" Class="text-white group-hover:text-purple-500" />
                    <span class="absolute -right-2 -top-2 flex h-4 w-4 items-center justify-center rounded-full bg-purple-500 font-bold text-[10px] text-white">@_cartActionService.CartDetails.TotalItemCount</span>
                </div>
            </div>
        </div>
    </div>
</header>

@code {
    [CascadingParameter(Name = Constant.CascadingNameParams.Mine)]
    public MineResponse _mine { get; set; }

    [CascadingParameter(Name = Constant.CascadingNameParams.Token)]
    public string _token { get; set; }

    [Parameter]
    public EventCallback OnLoggedOut { get; set; }

    [Parameter]
    public EventCallback OnOpenCartDrawer { get; set; }

    [Parameter]
    public EventCallback OnOpenHeaderDrawer { get; set; }

    [Parameter]
    public bool FirstLogin { get; set; }

    List<DAL.Models.Category> _lstCategory = [];
    List<DAL.Models.Platform> _lstPlatform = [];

    private string _searchKeyword = "";

    protected override async Task OnInitializedAsync()
    {

        if(_mine != null)
        {
            await _cartActionService.LoadCartAsync(_mine.Id);
        }

        var resCategory = await _categoryService.GetAll();

        if(resCategory.IsSuccess)
        {
            _lstCategory = resCategory.Data;
        }

        var resPlatform = await _platformService.GetAll();

        if (resPlatform.IsSuccess)
        {
            _lstPlatform = resPlatform.Data;
        }

        _cartActionService.OnCountChange += StateHasChanged;
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts[^1][0].ToString().ToUpper();
    }

    async Task OpenCartDrawer()
    {
        if(string.IsNullOrEmpty(_token) || _mine == null)
        {
            _snackbar.Add("Vui lòng đăng nhập!", MudBlazor.Severity.Warning);
            return;
        }
        await OnOpenCartDrawer.InvokeAsync();
    }


    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ExecuteSearch();
        }
    }

    private void ExecuteSearch()
    {
        var url = string.IsNullOrWhiteSpace(_searchKeyword)
            ? RouterConfig.Customer.Search
            : $"{RouterConfig.Customer.Search}?q={Uri.EscapeDataString(_searchKeyword)}";

        navigation.NavigateTo(url);
    }

    async Task OpenHeaderDrawer()
    {
        await OnOpenHeaderDrawer.InvokeAsync();
    }

    async Task Logout()
    {
        await OnLoggedOut.InvokeAsync();
    }

    public void Dispose()
    {
        _cartActionService.OnCountChange -= StateHasChanged;
    }
}